<top-bar pixel={{true}} type="primary" backgroundColor="bg-off-white" />
<top-bar
  pixel={{true}}
  type="navigation"
  navigate
  backgroundColor="bg-off-white"
  title="bni-scroll-picker"
  iconL="../../assets/icons/ic_common_arrow_back.svg"
/>

<view class="container">

  <view class="button-container">
    <text class="txt-body1-px">Select Number Type</text>
    <view class="scroll-picker-button" onTap="onChangeNumberType" data-number="1">
      1
    </view>
    <view class="scroll-picker-button" onTap="onChangeNumberType" data-number="2">
      2
    </view>
    <view class="scroll-picker-button" onTap="onChangeNumberType" data-number="3">
      3
    </view>
  </view>
  <view a:if="{{ selectedType == 1 }}" class="scroll-picker-container">
    <text class="txt-body1-sb-px">BNI Scroll Picker Number Without Num Value</text>
    <view class="divider"></view>
    <bni-scroll-picker
      type="number"
      minNumber="1"
      maxNumber="28"
      minSelectableNumber="1"
      onChangeScroll="onChangeScrollNumber"
    >
    </bni-scroll-picker>
  </view>

  <view a:if="{{ selectedType == 2 }}" class="scroll-picker-container">
    <text class="txt-body1-sb-px">BNI Scroll Picker Number With Num Value</text>
    <view class="divider"></view>
    <bni-scroll-picker
      type="number"
      numValue="{{numValue}}"
      minNumber="1"
      maxNumber="28"
      minSelectableNumber="1"
      onChangeScroll="onChangeScrollNumber"
    >
    </bni-scroll-picker>
  </view>

  <view a:if="{{ selectedType == 3 }}" class="scroll-picker-container">
    <text class="txt-body1-sb-px">BNI Scroll Picker Number With Num Value, Min Selectable Number and Immediate Change</text>
    <view class="divider"></view>
    <bni-scroll-picker
      type="number"
      numValue="{{numValueTypeThree}}"
      minNumber="17"
      maxNumber="100"
      minSelectableNumber="30"
      onChangeScroll="onChangeScrollNumber"
      immediateChange
    >
    </bni-scroll-picker>
  </view>


  <view class="scroll-picker-container">
    <text class="txt-body1-sb-px">BNI Scroll Picker Date</text>
    <view class="divider"></view>
    <bni-scroll-picker
      type="date"
      onChangeScroll="onChangeScroll"
      minimumMonth="9"
      langType="en-ID"
      defaultDate={{defaultDate}}
    >
    </bni-scroll-picker>

  </view>
</view>