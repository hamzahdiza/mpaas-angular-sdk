page {
  background-color: white;
}

.container {
  padding: 16px;
  box-sizing: border-box;
}

.scroll-picker-container {
  border: 1px black solid;
  margin-bottom: 30px;
  border-radius: 10px;
  padding: 16px;
}

.divider {
  width: 100%; border-bottom: 1px black solid;
}

.button-container {
  display: flex;
  flex-direction: row;
  padding: 10px;
}

.scroll-picker-button {
  height: 30px;
  width: 70px;
  background-color: var(--charcoal);
  border-radius: 5px;
  color: white;
  margin-right: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
}