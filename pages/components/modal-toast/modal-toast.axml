<modal-toast
  onCloseToastHandler="closeToastHandler"
  type="{{type}}"
  showToast="{{showToast}}"
  title="{{title}}"
  content="{{content}}"
  btnText="{{btnText}}"
  language="ID"
  urlPage="/pages/components/bni-button/bni-button"
  pixel
>
</modal-toast>

<view>
  <view className="txt-h1" style="display:flex; flex-direction:column justify-content: center; align-items: center; padding:10px">
    Modal - Toast Button
  </view>
  <view class="main-body">
    <bni-button
      type="primary"
      className="txt-h3-px bg-turquoise-300"
      onTap="toastHandler"
      data="success"
    >
      Success
    </bni-button>
    <bni-button className="txt-h3 bg-error" onTap="toastHandler" data="error">
      Error
    </bni-button>
  </view>
</view>

