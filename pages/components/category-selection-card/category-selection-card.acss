.gridbuttonfront {
  display: flex;
  padding: var(--spacing-spacing-312-px, 24rpx);
  gap: var(--spacing-spacing-416-px, 32rpx);
  border-radius: 6rpx;
  border-width: 2rpx;
  border-style: solid;
  align-items: flex-start;
  justify-content: space-evenly;
}

.popupTitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
}

.contentHeader {
  gap: var(--spacing-spacing-524-px, 28rpx);
}

.textTitle {
  font-feature-settings: 'clig'off, 'liga'off;
  font-style: normal;
  line-height: 120%;
}

.ant-popup-content {
  padding: 32rpx 32rpx 48rpx 32rpx;
  margin: 0 48rpx 95rpx 48rpx;
  border-radius: 15rpx;
  border-radius: 32rpx;
  background: var(--functional-bw-tones-white, #FFF);
  box-shadow: 0rpx 10rpx 32rpx 0rpx rgba(78, 78, 78, 0.27);
  height: auto;
}

.closePopUp {
  display: flex;
  align-self: flex-end;
  justify-content: right;
}

.closePopUp image {
  width: 48rpx;
  height: 48rpx;
}

.itemInsideLoop {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-spacing-28-px, 16rpx);
  align-self: stretch;
}

.ant-grid {
  padding: 0rpx;
  box-sizing: border-box;
  align-items: flex-start;
  align-self: stretch;
  display: flex;
  width: 100%;
}

.ant-grid-item {
  gap: var(--spacing-spacing-28-px, 16rpx);
}

.ant-grid-item-title {
  color: var(--functional-bw-tones-black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 24rpx;
  font-style: normal;
  font-weight: 400;
  line-height: 33.6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


.ant-grid-item-icon-image {
  width: 28px;
  height: 28px;
}

.insideContent {
  display: grid;
  grid-template-columns: 1fr;
  justify-content: center;
  gap: var(--spacing-spacing-524-px, 48rpx);
  align-self: stretch;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 16rpx;
  row-gap: 32rpx;
  padding: 0rpx;
  justify-content: center;
  align-items: flex-start;
}

.grid-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  flex: 1 0 0;
}

.icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  padding: 16rpx;
  justify-content: center;
  align-items: center;
  border-radius: 120rpx;
  border-width: 2rpx;
  border-style: solid;
  background: var(--functional-bw-tones-white, #FFF);
}

.grid-item text {
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  align-self: stretch;
}
.setGrid{
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.grid-item-main {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  gap: 4px;
  flex: 1 0 0;
  width: 94rpx;
  height: inherit;

}
.grid-item-main text{
   text-align: center;
   font-feature-settings: 'clig'off,
   'liga'off;
   align-self: stretch;
}

.gridIcon {
  position: relative;
  display: flex;
  padding: 16rpx;
  justify-content: center;
  align-items: center;
  border-radius: 360rpx;
  border-style: solid;
  border-width:2rpx;
  background: var(--functional-bw-tones-white, #FFF);
}

.icon-main {
  flex-shrink: 0;
}

.icon-check {
  position: absolute;
  top: -10rpx;
  right: -19rpx;
}

.grid-item-main text {
  display: flex;
  justify-content: center;
  text-align: center;
  font-feature-settings: 'clig'off,
    'liga'off;
  font-style: normal;
  line-height: 140%;
}

/* PIXEL */
.gridbuttonfront-px {
  display: flex;
  padding: var(--spacing-spacing-312-px, 12px);
  gap: var(--spacing-spacing-416-px, 16px);
  border-radius:3px;
  border-width:1px;
  border-style: solid;
  align-items: flex-start;
  justify-content: space-evenly;
}

.popupTitle-px {
  display: flex;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
}

.contentHeader-px {
  gap: var(--spacing-spacing-524-px, 14px);
}

.textTitle-px {
  font-feature-settings: 'clig'off, 'liga'off;
  font-style: normal;
  line-height: 120%;
}

.ant-popup-content {
  padding: 32rpx 32rpx 48rpx 32rpx;
  margin: 0 48rpx 95rpx 48rpx;
  border-radius: 15rpx;
  border-radius: 32rpx;
  background: var(--functional-bw-tones-white, #FFF);
  box-shadow: 0rpx 10rpx 32rpx 0rpx rgba(78, 78, 78, 0.27);
  height: auto;
}

.closePopUp-px {
  display: flex;
  align-self: flex-end;
  justify-content: right;
}

.closePopUp-px image {
  width: 12px;
  height: 12px;
}

.itemInsideLoop-px {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-spacing-28-px, 8px);
  align-self: stretch;
}

.ant-grid {
  padding: 0px;
  box-sizing: border-box;
  align-items: flex-start;
  align-self: stretch;
  display: flex;
  width: 100%;
}

.ant-grid-item {
  gap: var(--spacing-spacing-28-px, 8px);
}

.ant-grid-item-title-px {
  color: var(--functional-bw-tones-black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: 16.8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


.ant-grid-item-icon-image {
  width: 28px;
  height: 28px;
}

.insideContent-px {
  display: grid;
  grid-template-columns: 1fr;
  justify-content: center;
  gap: var(--spacing-spacing-524-px, 24px);
  align-self: stretch;
}

.grid-container-px {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 8px;
  row-gap: 16px;
  padding: 0px;
  justify-content: center;
  align-items: flex-start;
}

.grid-item-px {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  flex: 1 0 0;
}

.icon-px {
  display: flex;
  width:32px;
  height: 32px;
  padding: 8px;
  justify-content: center;
  align-items: center;
  border-radius: 60px;
  border-width: 1px;
  border-style: solid;
  background: var(--functional-bw-tones-white, #FFF);
}

.grid-item-px text {
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  align-self: stretch;
}
.setGrid-px{
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.grid-item-main-px {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  gap: 2px;
  flex: 1 0 0;
  width: 47px;
  height: inherit;

}
.grid-item-main-px text{
   text-align: center;
   font-feature-settings: 'clig'off,
   'liga'off;
   align-self: stretch;
}

.gridIcon-px {
  position: relative;
  display: flex;
  padding: 8px;
  justify-content: center;
  align-items: center;
  border-radius: 180px;
  border-style: solid;
  border-width:1px;
  background: var(--functional-bw-tones-white, #FFF);
}

.icon-main-px {
  flex-shrink: 0;
}

.icon-check-px {
  position: absolute;
  top: -5px;
  right: -9.5px;
}

.grid-item-main-px text {
  display: flex;
  justify-content: center;
  text-align: center;
  font-feature-settings: 'clig'off,
    'liga'off;
  font-style: normal;
  line-height: 140%;
}