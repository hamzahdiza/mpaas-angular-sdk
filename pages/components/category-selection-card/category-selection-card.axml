<top-bar type="primary" backgroundColor="bg-off-white" />
<top-bar
  type="navigation"
  navigate
  backgroundColor="bg-off-white"
  title="category-selection-card"
  iconL="../../assets/icons/ic_common_arrow_back.svg"
  pixel={{true}}
/>

<view class="gridbuttonfront bg-white border-pale-gray" onTap="onOpenPopup">
  <block a:for={{dataCategoryMain}}>
    <view class="setGrid" onTap="onOpenPopup">
      <view class="grid-item-main">
        <view class="gridIcon border-success bg-white" style="width:32px;height:32px;">
          <image class="icon-main" src="{{ item.icon }}" style="width:32px;height:32px" />
          <image
            a:if="{{item.selected ===true}}"
            class="icon-check"
            src="../../assets/icons/ic_common_check_filled.svg"
            style="width:32px;height:32px"
          />
        </view>
        <text class="txt-body3-px txt-black">{{item.title}}</text>
      </view>
    </view>
  </block>
</view>

