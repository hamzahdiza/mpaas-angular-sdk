<bnipopupmini onClose="onClosePopup" basicVisible={{basicVisible}} pixel={{true}}>
  <view slot="contentInside">
    <view class="popupCardContent-px">
      <view class="contentHeader-px">
        <view class="closePopUp-px" onTap="handlePopupClose">
          <image src="../../assets/icons/ic_common_close.svg" alt="x" />
        </view>
      </view>
      <view class="insideContent-px">
        <view>
          <view class="popupTitle-px">
            <view class="textTitle-px">
              <text class="txt-black txt-h3-px">Ubah Kategori</text>
            </view>
          </view>
        </view>
        <view class="contentBody-px">
          <form onSubmit="onSubmitCategory">
            <view>
              <view class="grid-container-px">
                <block a:for="{{dataCategory}}">
                  <view class="grid-item-px" onTap="handleTapItem" data-set="{{dataCategory}}" id="{{item.id}}">
                    <view class="gridIcon-px border-success bg-white">
                      <image
                        class="icon-main-px"
                        src="{{ item.icon }}"
                        style="width:32px;height:32px"
                      />
                      <image
                        a:if="{{item.selected ===true}}"
                        class="icon-check-px"
                        src="../../assets/icons/ic_common_check_filled.svg"
                        style="width:32px;height:32px"
                      />
                    </view>
                    <text class="txt-body3-px txt-black"> {{item.title}}</text>
                  </view>
                </block>
              </view>
            </view>
          </form>
        </view>
      </view>
    </view>
  </view>


</bnipopupmini>