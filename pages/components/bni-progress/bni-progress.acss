page {
  background: white;
}

.card-container {
  width: 327px;
  height: 133px;
  border: 1px solid #F0F0F0;
  border-radius: 8px;
  padding: 16px;
  box-sizing: border-box;
  margin: auto;
}

.top-content {
  display: flex;
  align-items: center;
}

.top-content text {
  margin-right: auto;
  margin-left: 8px;
}

.bottom-content {
  display: flex;
}

.bottom-left-content {
  margin-right: auto;
}

.bottom-left-content text:nth-child(2) {
  margin-left: 5px;
}