.main-container{
  width: calc(100vw - 20px);
  min-height: calc(100vh - 20px);
  padding: 10px;
}

.loader-usage{
  display: flex;
  background-color: white;
  padding: 15px 10px;
  margin-top: 10px;
  border-radius: 15px;
  box-shadow: inset 0px 0px 7.5px 0px rgba(0,0,0,0.25)
}

.loader-container{
  flex: 1;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  justify-content: flex-start;
}

.loader-desc{
  padding-top: 5px;
  padding-bottom: 5px;
}

button{
  border-radius: 15px;
}