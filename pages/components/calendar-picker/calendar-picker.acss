.main {
  min-height: 100vh;
  background-color: #F7F7F8;
}

.sticky-header {
  position: sticky;
  top: 0;
  z-index: 999;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.content {
  padding: 24rpx 32rpx;
}

/* Segmented control */
.segmented-control {
  display: flex;
  flex-direction: row;
  background-color: #EDEDF0;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.segment-item.active {
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.segment-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #8A8A8E;
}

.segment-text.active-text {
  color: #1A1A1A;
  font-weight: 600;
}

/* Month filter card */
.calendar-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.calendar-button-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.calendar-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.chevron-icon {
  width: 24rpx;
  height: 24rpx;
}

.hp-filter-text {
  color: #1A1A1A;
  font-size: 28rpx;
}

.control-group {
  margin-bottom: 20rpx;
}

.control-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #8A8A8E;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}