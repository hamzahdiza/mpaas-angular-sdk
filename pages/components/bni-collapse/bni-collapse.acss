.content-pages-px {
  display: flex;
  padding: 24px;
  flex-direction: column;
  align-items: flex-start;
}

.tab-content text {
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;
  font-family: "TT Interphases Pro";
  font-size: 28rpx;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  margin-top: 16rpx;
}

.tab-content-px text {
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  margin-top: 8px;
}

.tab-label {
  font-family: "TT Interphases Pro";
  font-size: 28rpx;
  font-weight: 700;
  color: black;

}

.tab-label-px {
  font-family: "TT Interphases Pro";
  font-size: 14px;

  font-weight: 700;
  color: black;
}