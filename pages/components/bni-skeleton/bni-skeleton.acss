.avatar {
  display: flex;
  margin: 10px;
  flex-direction: column;
}

.input {
  display: flex;
  margin: 10px;
  flex-direction: column;
}

.cssClassInput {
  display: flex;
  background-color: red;
  color: red;
}

.button {
  display: flex;
  margin: 10px;
  flex-direction: column;
}

.buttonDetail {
  display: flex;
  flex-direction: column;
  margin: 10px;
  padding-left: 10px
}

.containers {
  display: grid;
  grid-gap: 8px;
  grid-template-columns: auto auto;
  justify-content: start;
}

.content {
  display: flex;
  float: left;
  text-align: justify;
}

.avatarSetting {
  background-color: blue;
}

.previewComplex {
  display: flex;
}

.contentButton {
  display: flex;
}

.containerParagraph {
  width: auto;
  white-space: nowrap;
  overflow-x: auto;
}

.insideParagraph {
  display: flex;
}

.paragraph-container {
  flex: 0 0 100vw;
  max-width: 100%;
}

.paragraph {
  padding: 10px;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.flexibleSkeleton {
  display: flex;
  flex-direction: column;
  margin-bottom: 10px;
  margin-left: 10px;
  /* background-color: red;
  justify-content: center;
  align-items: center; */
}

.testingArea {
  display: flex;
  width: 295px;
  height: 132px;
  background-color: green;

}
.containerCard{
  display: flex;
  justify-content: center;
}

.card {
  width: 300px;
  min-height: 100px;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.card img {
  width: 100%;
  height: auto;
}

.card-content {
  padding: 16px;
}

.card-content h2 {
  margin-top: 0;
  color: #333;
}

.card-content p {
  margin-bottom: 0;
  color: #666;
}