.newspaper-page {
  min-height: 100vh;
  background-color: #F4F3EF;
}

.sticky-header {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.layout-grid {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Base segment style */
.segment {
  width: 100%;
  background-color: #FFFFFF;
  border: 2rpx solid #1A1A1A;
  border-radius: 4rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.9);
}

.segment-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #B5342E;
  margin-bottom: 12rpx;
}

.segment-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.35;
  font-family: Georgia, "Times New Roman", serif;
}

.segment-title-xl {
  font-size: 48rpx;
  line-height: 1.25;
}

.segment-title-sm {
  font-size: 26rpx;
  line-height: 1.4;
}

.segment-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5C5C5C;
  line-height: 1.5;
}

/* Tinggi masing-masing segmen, total > 1000px */
.segment-1 {
  height: 420px;
}

.segment-2 {
  height: 380px;
}

.segment-3 {
  height: 360px;
}

.segment-4 {
  height: 340px;
}