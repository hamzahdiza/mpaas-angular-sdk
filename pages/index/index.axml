<view
  class="container"
  scroll-y="{{true}}"
  catchTouchStart="handleCatchTouchStart"
>
  <view>
    <top-bar
      pixel={{true}}
      exit={{true}}
      type="navigation"
      navigate={{true}}
      backgroundColor="#fff"
      title="MPAAS DUMMY"
      iconL="../../image/ic_arrow_back.svg"
      safeArea
    />
    <top-bar
      pixel={{true}}
      type="navigation"
      navigate={{true}}
      backgroundColor="#fff"
      title="MPAAS DUMMY"
      iconL="../../image/ic_arrow_back.svg"
      onIconLTap="exitMiniprogram"
    />
  </view>
  <view style="padding: 20rpx; background-color: #ffebee; text-align: center; color: #d32f2f; font-weight: bold; font-size: 18px;">
    Sesi akan reset dalam: {{countdownDisplay}} detik
  </view>
  <view style="fontSize: 50px;">
    {{flag}}
  </view>
  <view>
    <button class="item" type="primary" onTap="goToAppDemo">
      Go to App Demo ANT
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="getData">
      Get Data
    </button>
    <textarea placeholder="Input multiple lines" value={{allData}} auto-height />
  </view>
  <text>TEST TEST TEST</text>
  <view>
    <button class="item" type="primary" onTap="goToPdfBinary">
      Open PDF from Binary Data
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="getParameter">
      Get Parameter
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateTo">
      Signature
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToJSAPI">
      JS API METHOD
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToWebView">
      LIFESTYLE MICROSITE
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToUploadPdf">
      Upload PDF
    </button>
    <button class="item" type="primary" onTap="navigateToOpenUrl">
      Open URL
    </button>
    <view>
      <input
        maxlength=2000
        placeholder="Input Duration Introduction"
        style="width: 660rpx; height: 50rpx;"
        onInput="handleInputRsp"
      />
    </view>
    <button class="item" type="primary" onTap="toRspIntroduction">
      Open RSP Introduction
    </button>
    <input
      maxlength=2000
      placeholder="Input urlMicrosite"
      style="width: 660rpx; height: 50rpx;"
      onInput="handleInput"
    />
  </view>
  <button class="item" type="primary" onTap="navigateToOpenUrl">
    Go To Webview
  </button>
  <button class="item" type="primary" onTap="navigateToOpenUrlUndian">
    Go To Webview Undian
  </button>
  <view class="item">
    <input
      maxlength=2000
      placeholder="Input Path to Gather Screen"
      style="width: 660rpx; height: 50rpx;"
      onInput="handleInputPathToNative"
    />
    <view class="item">
      <input
        maxlength=2000
        placeholder="Input URL Microsite Native"
        style="width: 660rpx; height: 50rpx;"
        onInput="handleInputUrlToNative"
      />
    </view>
    <button class="item" type="primary" onTap="navigateToWebViewNative">
      Go To Webview Native
    </button>
    <view>
      <input
        maxlength=2000
        placeholder="Input Phone Number"
        style="width: 660rpx; height: 50rpx;"
        onInput="handleInputPhone"
      />
    </view>
    <button class="item" type="primary" onTap="handlePhone">
      Call Phone
    </button>
  </view>
  <view style="display: flex; flex-direction: column">
    <text>startPeriod: {{startPeriod}}</text>
    <text>endPeriod: {{endPeriod}}</text>
  </view>

  <button class="item" type="primary" onTap="checkContact">
    Go To Check Contact
  </button>
  <view>
    version 1.0.2.16
  </view>
  <button class="item" size="default" type="primary" onTap="goToDatePicker">
    Go To Date Picker
  </button>
  <button class="item" size="default" type="primary" onTap="goToGiriMicrosite">
    Go to Microsite Giri
  </button>
  <button class="item" size="default" type="primary" onTap="goToParent">
    Go to Parent
  </button>
  <button class="item" size="default" type="primary" onTap="goToAndroidTest">
    Android Test Case
  </button>
  <button class="item" size="default" type="primary" onTap="goToQrcode">
    QR CODE
  </button>
  <button class="item" size="default" type="primary" onTap="goToGetLocation">
    get location new
  </button>
  <button class="item" size="default" type="primary" onTap="goToRequestFunc">
    Test function library
  </button>
  <view class="item" style="padding: 20rpx; background: #f5f5f5; margin-bottom: 20rpx;">
    <input
      type="number"
      placeholder="Input Maksimal Durasi Idle (Detik)"
      style="width: 100%; height: 60rpx; background: #fff; padding: 0 10rpx;"
      onInput="handleInputDuration"
    />
  </view>

  <button class="item" size="default" type="primary" onTap="startCustomIdle">
    Start Idle Time Countdown
  </button>
  <view style="height:60px">

  </view>
</view>