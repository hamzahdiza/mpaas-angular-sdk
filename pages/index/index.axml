<view class="container">
  <view>
    <button class="item" type="primary" onTap="getData">
      Get Data
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="getParameter">
      Get Parameter
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateTo">
      Signature
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToJSAPI">
      JS API METHOD
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToWebView">
      LIFESTYLE MICROSITE
    </button>
  </view>
  <view>
    <button class="item" type="primary" onTap="navigateToUploadPdf">
      Upload PDF
    </button>
    <button class="item" type="primary" onTap="navigateToOpenUrl">
      Open URL
    </button>
    <view>
      <input maxlength=2000 placeholder="Input" style="width: 660rpx; height: 50rpx;" onInput="handleInput"/>
    </view>
    <button class="item" type="primary" onTap="navigateToOpenUrl">
      Go To Webview
    </button>
  </view>
  <view>
    <view>
      version 1.0.1.18
    </view>
  </view>