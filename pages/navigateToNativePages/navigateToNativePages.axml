<view style="box-sizing : border-box; display : flex; flex-direction : column; padding : 20px; gap : 5px; width : 100% ; height : 100%">
  <button size="default" type="primary" onTap="onTap1">key null value null</button>
  <button size="default" type="primary" onTap="onTap2">key filled value null</button>
  <button size="default" type="primary" onTap="onTap3">key filled value filled</button>
  <button size="default" type="primary" onTap="onTap4">disbursement key null value null</button>
  <button size="default" type="primary" onTap="onTap5">disbursement key filled value null</button>
  <button size="default" type="primary" onTap="onTap6">disbursement key filled value filled</button>
</view>