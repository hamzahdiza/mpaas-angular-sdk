<import src="/pages/rendering-pages/landing/landing.axml" />
<template is="landing" />
<top-bar
  pixel
  type="chipButton"
  navigate
  exit
  backgroundColor="{{ failureLoad ? 'bg-white' : 'bg-off-white' }}"
  title="{{isLoading && !failureLoad?'': 'BIONS'}}"
  iconL="../../../image/ic_arrow_back.svg"
  typeChipButton="primary"
  onChipButtonTap="toProfileInvestor"
  titleChipButton="Profile"
  iconChipButton="../assets/icons/ic_common_users.svg"
  classChipButton="txt-label1-sb border-pale-gray"
/>