
<top-bar
  pixel={{true}}
  type="navigation"
  navigate={{true}}
  backgroundColor="#fff"
  title="QR code"
  iconL="../../../image/ic_arrow_back.svg"
/>
<view style="display:flex;margin-bottom:60px;">
  <view onTap="onChooseSaveApi" data-api="saveImage" style="width:auto;height:50px;background:{{saveImageSelected === 'saveImage' ? 'green':'blue'}};margin-right:30px;display:flex;justify-content:center;align-items:center;color:white">
    <text>my.saveImage</text>
  </view>
  <view onTap="onChooseSaveApi" data-api="saveImageToPhotosAlbum" style="width:auto;height:50px;background:{{saveImageSelected === 'saveImageToPhotosAlbum' ? 'green':'blue'}};margin-right:30px;display:flex;justify-content:center;align-items:center;color:white">
    <text>my.saveImageToPhotosAlbum</text>
  </view>
</view>
<view style="display:flex;">
  <view onTap="onChooseFilePath" data-path="tempFilePath" style="width:100px;height:50px;background:{{selectedFilePath === 'tempFilePath' ? 'green':'blue'}};margin-right:30px;display:flex;justify-content:center;align-items:center;color:white">
    <text>tempFilepath</text>
  </view>
  <view onTap="onChooseFilePath" data-path="apFilePath" style="width:100px;height:50px;background:{{selectedFilePath === 'apFilePath' ? 'green':'blue'}};margin-right:30px;display:flex;justify-content:center;align-items:center;color:white">
    <text>apFilePath</text>
  </view>
  <view onTap="onChooseFilePath" data-path="filePath" style="width:100px;height:50px;background:{{selectedFilePath === 'filePath' ? 'green':'blue'}};display:flex;justify-content:center;align-items:center;color:white">
    <text>filePath</text>
  </view>
</view>
<input
  style="height:40px; margin: 24px; padding:8px; border: 1px solid #777777; flex: 1 0 0; display:flex;"
  placeholder="input string"
  onInput="bindKeyInput"
/>

<button size="default" type="primary" onTap="savePNG">
  Generate QR Code and save
</button>


