page{
  height: 100vh;
  overflow: hidden;
}

.button-container{
  height:100%; 
  padding:40px; 
  display:grid; 
  display: grid;
  grid-template-rows: 50px 50px;
  gap: 10px;
}

.container {
  display: flex;
  min-height: calc(100vh - 46.992px - 43.997px - 12px - 24px - 10px);
  flex-direction: column;
  align-items: center;
  padding-top: 24px;
  padding-bottom: 10px;
}

.description-container {
  display: flex;
  flex-direction: column;
}

.description-title {
  width: 327px;
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 2 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 28.8px */
}

.description-footer {
  width: 327px;
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Body/Body 2 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  /* 19.6px */
}

.sticky-botton {
  display: flex;
  height: 48px;
  padding: 12px 32px;
  justify-content: center;
  align-items: center;
  gap: 4px;
  /* flex-shrink: 0; */

}

.button-class {
  display: flex;
  height: 48px;
  padding: 12px 32px;
  justify-content: center;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;

  border-radius: 32px;
  background: var(--functional-bw-tones-black, #0E0E0E);

  /* Light BG/Elevation 3 - Components */
  box-shadow: 0px 8px 10px 0px rgba(78, 78, 78, 0.10);
}

.button-class image {
  width: 24px;
  height: 24px;
}

.button-class text {
  color: var(--functional-bw-tones-white, #FFF);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  font-family: "TT Interphases Pro";
  font-size: 16px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.main-container {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  align-self: stretch;
}

.chevronRight{
  background-color: var(--off-white);
  width: 24px;
  height: 24px;
  padding: 8px;
  border-radius: 98px 0 0 98px;
}
.chevronLeft{
  background-color: var(--off-white);
   width: 24px;
  height: 24px;
  padding: 8px;
  border-radius: 0 98px 98px 0;
}


