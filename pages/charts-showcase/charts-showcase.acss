/* Charts Showcase Styles */

.charts-showcase-root {
  background-color: #F8FAFC;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sticky-nav {
  position: sticky;
  top: 0;
  width: 100%;
  background-color: #0F172A;
  z-index: 100;
}

/* Horizontal Scrollable Tabs */
.tab-scroll-wrap {
  width: 100%;
  background-color: #FFFFFF;
  border-bottom: 1px solid #E2E8F0;
  white-space: nowrap;
}

.tab-segment-bar {
  display: flex;
  padding: 10px 16px;
  gap: 8px;
  align-items: center;
}

.tab-segment-item {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 8px 16px;
  border-radius: 9999px;
  background-color: #F1F5F9;
  border: 1px solid #E2E8F0;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-segment-item.active {
  background-color: #005E82;
  border-color: #005E82;
  box-shadow: 0 2px 8px rgba(0, 94, 130, 0.25);
}

.tab-icon {
  font-size: 14px;
  margin-right: 6px;
}

.tab-label {
  font-size: 13px;
  font-weight: 600;
  color: #475569;
}

.tab-segment-item.active .tab-label {
  color: #FFFFFF;
}

/* Scroll Body */
.charts-body-scroll {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
}

/* Card Container */
.chart-section-card {
  background-color: #FFFFFF;
  border-radius: 20px;
  padding: 20px 16px;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  margin-bottom: 24px;
  box-sizing: border-box;
  border: 1px solid #F1F5F9;
}

.chart-header {
  margin-bottom: 16px;
}

.header-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.badge-tag {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #005E82;
  background-color: #E0F2FE;
  padding: 4px 8px;
  border-radius: 6px;
}

.badge-sub {
  font-size: 11px;
  font-weight: 600;
  color: #10B981;
}

.chart-main-title {
  display: block;
  font-size: 18px;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 4px;
}

.chart-main-desc {
  display: block;
  font-size: 12px;
  line-height: 18px;
  color: #64748B;
}

/* Buy / Sell Toggle Pill */
.toggle-pill-row {
  display: flex;
  background-color: #F1F5F9;
  border-radius: 12px;
  padding: 4px;
  margin-bottom: 16px;
}

.toggle-pill {
  flex: 1;
  text-align: center;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 600;
  color: #64748B;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.toggle-pill.active-buy {
  background-color: #005E82;
  color: #FFFFFF;
  box-shadow: 0 2px 6px rgba(0, 94, 130, 0.2);
}

.toggle-pill.active-sell {
  background-color: #E11D48;
  color: #FFFFFF;
  box-shadow: 0 2px 6px rgba(225, 29, 72, 0.2);
}

/* Stat Metrics Grid */
.stat-metrics-grid {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.stat-metric-card {
  flex: 1;
  background-color: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 12px;
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 11px;
  font-weight: 600;
  color: #64748B;
  margin-bottom: 4px;
}

.stat-value {
  font-size: 16px;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 2px;
}

.stat-note {
  font-size: 10px;
  color: #94A3B8;
}

.txt-emerald {
  color: #059669 !important;
}

.txt-rose {
  color: #E11D48 !important;
}

.txt-navy {
  color: #005E82 !important;
}

.txt-charcoal {
  color: #334155 !important;
}

/* Canvas Chart Box */
.canvas-chart-box {
  width: 100%;
  min-height: 180px;
  position: relative;
  margin-bottom: 12px;
}

/* Period Chips */
.period-chips-scroll-wrap {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 8px 0;
  margin-bottom: 16px;
  align-items: center;
}

.period-chip {
  flex-shrink: 0;
  padding: 6px 14px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid #E2E8F0;
  background-color: #FFFFFF;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s ease;
}

.period-chip.selected {
  background-color: #E6F4F2;
  color: #008A80;
  border-color: #008A80;
  font-weight: 700;
}

/* Info Callout */
.info-callout {
  display: flex;
  align-items: flex-start;
  padding: 12px 14px;
  background-color: #FFFBEB;
  border: 1px solid #FDE68A;
  border-radius: 12px;
  margin-top: 16px;
}

.info-callout-icon {
  font-size: 16px;
  margin-right: 10px;
  line-height: 20px;
}

.info-callout-content {
  flex: 1;
}

.info-callout-title {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #92400E;
  margin-bottom: 2px;
}

.info-callout-desc {
  display: block;
  font-size: 11px;
  line-height: 16px;
  color: #B45309;
}

/* Portfolio Doughnut */
.portfolio-total-banner {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
  border-radius: 12px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}

.portfolio-total-label {
  font-size: 11px;
  font-weight: 500;
  color: #94A3B8;
  margin-bottom: 4px;
}

.portfolio-total-val {
  font-size: 20px;
  font-weight: 700;
  color: #FFFFFF;
}

.doughnut-canvas-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 12px 0;
}

.selected-slice-banner {
  display: flex;
  align-items: center;
  padding: 10px 14px;
  background-color: #F8FAFC;
  border-radius: 10px;
  border: 1px solid #E2E8F0;
  margin-bottom: 16px;
}

.slice-badge {
  font-size: 12px;
  margin-right: 8px;
}

.slice-name {
  font-size: 13px;
  font-weight: 600;
  color: #0F172A;
  flex: 1;
}

.slice-val {
  font-size: 13px;
  font-weight: 700;
  color: #005E82;
}

.category-legend-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.legend-row-item {
  display: flex;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #F1F5F9;
}

.legend-row-item:last-child {
  border-bottom: none;
}

.legend-color-dot {
  width: 10px;
  height: 10px;
  border-radius: 9999px;
  margin-right: 12px;
}

.legend-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.legend-name {
  font-size: 13px;
  font-weight: 600;
  color: #1E293B;
}

.legend-percent {
  font-size: 11px;
  color: #64748B;
}

.legend-amount {
  font-size: 13px;
  font-weight: 600;
  color: #0F172A;
}

/* Bar Chart Tab */
.bar-summary-pill {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background-color: #F0FDF4;
  border: 1px solid #BBF7D0;
  border-radius: 8px;
  margin-bottom: 16px;
}

.bar-summary-icon {
  margin-right: 8px;
}

.bar-summary-text {
  font-size: 12px;
  font-weight: 600;
  color: #15803D;
}

.barchart-container-box {
  width: 100%;
  margin-bottom: 16px;
}

.legend-barchart-row {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 16px;
}

.legend-badge-item {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #475569;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  margin-right: 6px;
}

.bg-success {
  background-color: #02C794;
}

.bg-error {
  background-color: #D65C5C;
}

.section-divider {
  height: 1px;
  background-color: #E2E8F0;
  margin: 20px 0;
}

.sub-sec-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12px;
}

.mg-t-16-px {
  margin-top: 16px;
}

/* Cashflow Tab */
.scenario-chips-row {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.scenario-chip {
  padding: 6px 12px;
  border-radius: 9999px;
  font-size: 12px;
  font-weight: 600;
  background-color: #F1F5F9;
  border: 1px solid #E2E8F0;
  color: #475569;
  cursor: pointer;
  transition: all 0.2s ease;
}

.scenario-chip.active-surplus {
  background-color: #ECFDF5;
  border-color: #10B981;
  color: #047857;
  font-weight: 700;
}

.scenario-chip.active-deficit {
  background-color: #FEF2F2;
  border-color: #EF4444;
  color: #B91C1C;
  font-weight: 700;
}

.scenario-chip.active-balanced {
  background-color: #EFF6FF;
  border-color: #3B82F6;
  color: #1D4ED8;
  font-weight: 700;
}

.cashflow-embedded-wrap {
  width: 100%;
  background: #F8FAFC;
  border-radius: 16px;
  overflow: hidden;
  padding: 8px 4px;
  box-sizing: border-box;
  border: 1px solid #E2E8F0;
  margin-bottom: 16px;
}

.cashflow-metric-row {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.cashflow-metric-item {
  flex: 1;
  background-color: #F8FAFC;
  border-radius: 12px;
  padding: 10px 8px;
  border: 1px solid #E2E8F0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.metric-label {
  font-size: 10px;
  font-weight: 600;
  color: #64748B;
  margin-bottom: 4px;
}

.metric-val {
  font-size: 13px;
  font-weight: 700;
}
