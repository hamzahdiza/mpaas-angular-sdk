page {
  background-color: white;
  padding: 0;
  margin: 0;
}

.container {
  padding: 16px;
  box-sizing: border-box;
}

.scroll-picker-container {
  border: 1px black solid;
  margin-bottom: 30px;
  border-radius: 10px;
  padding: 16px;
}

.divider {
  width: 100%; border-bottom: 1px black solid;
}

.button-container {
  display: flex;
  flex-direction: row;
  padding: 10px;
}

.scroll-picker-button {
  height: 30px;
  width: 70px;
  background-color: black;
  border-radius: 5px;
  color: white;
  margin-right: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scroll-picker-button-clicked {
  height: 30px;
  width: 70px;
  background-color: white;
  border-radius: 5px;
  color: black;
  margin-right: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: black solid 1px;
}

.container {
  background-color: white;
}

.pickerContainer {
  padding: 0 24px;
  height: 184px;
}

.indicatorStyle {
  border: none;
  width: 0px;
}

.columnStyle {
  max-width: 20px;
  max-height: 22px;
}

.txt-blue {
  color: blue;
}

.faded-opacity {
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 1) 50%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 1) 50%,
    rgba(0, 0, 0, 0) 100%
  );

  mask-mode: alpha;
  -webkit-mask-mode: alpha;

  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;

  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
}

.page-picker-container {
  height: 170px;
  width: 263px;
  border: 2px solid gray;
  padding: 20px;
}