<view>
  <top-bar
    type="navigation"
    navigate
    backgroundColor="bg-off-white"
    title="BNI PICKER VIEW"
    iconL="/image/ic_common_arrow_back.svg"
    safeArea={{true}}
    pixel
    onIconLTap="navBack"
  />
  <top-bar pixel={{true}} type="primary" backgroundColor="bg-off-white" />
  <view class="container">

    <view class="button-container">
      <text class="txt-body1-px">Select Number Type</text>
      <button class="{{ selectedType == 1 ? 'scroll-picker-button-clicked' : 'scroll-picker-button' }}" onTap="onChangeNumberType" data-number="1">
        1
      </button>
      <button class="{{ selectedType == 2 ? 'scroll-picker-button-clicked' : 'scroll-picker-button' }}" onTap="onChangeNumberType" data-number="2">
        2
      </button>
      <button class="{{ selectedType == 3 ? 'scroll-picker-button-clicked' : 'scroll-picker-button' }}" onTap="onChangeNumberType" data-number="3">
        3
      </button>
      <button class="{{ selectedType == 4 ? 'scroll-picker-button-clicked' : 'scroll-picker-button' }}" onTap="onChangeNumberType" data-number="4">
        4
      </button>
    </view>

    <view a:if="{{ selectedType == 1 }}" style="width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <view class="page-picker-container">
        <bni-scroll-picker-v2 type="2" onChangeScroll="onChangeScroll" minimumMonth="9" langType="en-ID" />
      </view>
      <view class="txt-h2" style="margin-top: 20px">
        {{ month + '  ' + year }}
      </view>
    </view>

    <view a:if="{{ selectedType == 2 }}" style="width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <view class="page-picker-container">
        <bni-scroll-picker-v2 defaultDate="{{defaultDate}}" type="2" onChangeScroll="onChangeScroll" minimumMonth="9" langType="en-ID" />
      </view>
      <view class="txt-h2" style="margin-top: 20px">
        {{ month + '  ' + year }}
      </view>
    </view>

    <view a:if="{{ selectedType == 3 }}" style="width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <view class="page-picker-container">
        <bni-scroll-picker-v2 type="1"
        minNumber="1"
        maxNumber="28"
        minSelectableNumber="1"
        onChangeScroll="onChangeScrollNumber"
        defaultValue={{defaultValue}}
        numValue="1" />
      </view>
      <view class="txt-h2" style="margin-top: 20px">
        {{ numSelected }}
      </view>
    </view>

    <view a:if="{{ selectedType == 4 }}" class="scroll-picker-container">
      <text class="txt-body1-sb-px">Second BNI Scroll Picker (toLowerCase)</text>
      <view class="divider"></view>
      <case-sensitive-bni-scroll-picker
        type="date"
        onChangeScroll="onChangeScroll"
        minimumMonth="5"
        langType="en-ID"
        defaultDate={{defaultDate}}
      >
      </case-sensitive-bni-scroll-picker>

    </view>

  </view>