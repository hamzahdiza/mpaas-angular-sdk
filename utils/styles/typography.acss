.underline {
  text-decoration: underline;
}

.txt-center {
  text-align: center;
}

.txt-left {
  text-align: left;
}

.txt-right {
  text-align: right;
}

.txt-justify {
  text-align: justify;
}

/*letter-spacing*/
.ls-1 {
  letter-spacing: 1rpx;
}

.ls-0 {
  letter-spacing: 0rpx;
}

.va-middle {
  vertical-align: middle;
}

/*word break*/
.ww-bw {
  word-wrap: break-word;
}

.ww-ba {
  word-break: break-all;
}

.ww-pw {
  white-space: pre-wrap;
}

.ww-n {
  white-space: normal;
}

.ww-nw {
  white-space: nowrap;
}

.ww-pl {
  white-space: pre-line;
}

.to-e-1 {
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

.to-e-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-wrap: break-word;
  white-space: normal !important;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

