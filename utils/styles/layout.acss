/*border*/
.b-0 {
  border: 0;
}

.b-2-s-c6c6c6 {
  border: 2rpx solid #C6C6C6;
}

.b-2-s-e5e5e5 {
  border: 2rpx solid #e5e5e5;
}

.b-2-s-dadada {
  border: 2rpx solid #dadada;
}

.b-2-s-dadada {
  border: 2rpx solid #dadada;
}

.b-2-d-dadada {
  border: 2rpx dashed #dadada;
}

.bb-2-s-dadada {
  border-bottom: 2rpx solid #dadada;
}

.bb-2-d-eeeeee {
  border-bottom: 2rpx dashed #eeeeee;
}

