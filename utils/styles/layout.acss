/*Global*/
.bs {
  -webkit-box-sizing: border-box;
  -ms-box-sizing: border-box;
  -o-box-sizing: border-box;
  -moz-box-sizing: border-box;
  box-sizing: border-box;
}

.v-h {
  visibility: hidden;
}

/*postion*/
.pr {
  position: relative;
}

.pa {
  position: absolute;
}

.ps {
  position: sticky;
}

.pf {
  position: fixed;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.p-l-0 {
  left: 0;
}

.p-l-p-50 {
  left: 50%;
}

.p-t-0 {
  top: 0;
}

.p-t-p-50 {
  top: 50%;
}

.p-r-0 {
  right: 0;
}

.p-b-0 {
  bottom: 0;
}

.zi-n-1 {
  z-index: -1;
  /*negative*/
}

