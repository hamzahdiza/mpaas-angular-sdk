/* ═════════════════════════════════════════════════════════════════ */
/* WONDR LIFESTYLE LANDING PAGE — MINIMALIST & STYLISH DESIGN SYSTEM */
/* ═════════════════════════════════════════════════════════════════ */

/* ─── 1. BASE & ROOT ─── */
.landing-page-root {
  background-color: #F8FAFC;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "TT Interphases Pro", "Segoe UI", Roboto, sans-serif;
  color: #0F172A;
  -webkit-font-smoothing: antialiased;
}

.sticky-nav {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
}

.landing-scroll-body {
  width: 100%;
  box-sizing: border-box;
}

/* ─── 2. HERO DISCOVERY BANNER & SEARCH ─── */
.hero-wrapper {
  background: linear-gradient(145deg, #0F172A 0%, #1E293B 45%, #312E81 100%);
  padding: 24px 20px 42px;
  position: relative;
  overflow: hidden;
}

.hero-mesh-bg {
  position: absolute;
  right: -30px;
  top: -30px;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.4) 0%, rgba(168, 85, 247, 0.2) 50%, transparent 70%);
  filter: blur(28px);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.hero-tag-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  margin-bottom: 12px;
  align-self: flex-start;
}

.hero-tag-dot {
  color: #38BDF8;
  font-size: 8px;
}

.hero-tag-text {
  color: #F1F5F9;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.hero-headline {
  color: #FFFFFF;
  font-size: 22px;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 6px;
  letter-spacing: -0.3px;
}

.hero-subtext {
  color: #94A3B8;
  font-size: 12.5px;
  font-weight: 400;
  line-height: 1.45;
  margin-bottom: 18px;
}

.search-bar-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 14px;
  padding: 10px 14px;
  gap: 10px;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.18), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.search-icon {
  font-size: 15px;
  color: #64748B;
}

.search-input {
  flex: 1;
  font-size: 13px;
  color: #0F172A;
  background: transparent;
  border: none;
  outline: none;
}

.search-placeholder {
  color: #94A3B8;
  font-size: 12.5px;
}

/* ─── 3. MAIN CATEGORY HUB (4 PRIMARY HUBS) ─── */
.category-hub-card {
  margin: -24px 16px 22px;
  background: #FFFFFF;
  border-radius: 20px;
  padding: 16px 10px 14px;
  box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
  border: 1px solid rgba(226, 232, 240, 0.9);
  position: relative;
  z-index: 10;
}

.category-hub-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  align-items: flex-start;
  text-align: center;
}

.category-hub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.category-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 8px;
  transition: transform 0.15s ease;
}

.category-icon-wrap:active {
  transform: scale(0.92);
}

.category-icon-img {
  width: 28px;
  height: 28px;
}

.theme-purple {
  background: linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%);
}

.theme-teal {
  background: linear-gradient(135deg, #CCFBF1 0%, #99F6E4 100%);
}

.theme-amber {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.theme-rose {
  background: linear-gradient(135deg, #FFE4E6 0%, #FECDD3 100%);
}

.category-badge {
  position: absolute;
  top: -6px;
  right: -10px;
  font-size: 8.5px;
  font-weight: 700;
  padding: 2px 5px;
  border-radius: 7px;
  color: #FFFFFF;
  white-space: nowrap;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
}

.badge-purple {
  background: #7C3AED;
}

.badge-teal {
  background: #0D9488;
}

.badge-amber {
  background: #D97706;
}

.category-item-title {
  font-size: 11.5px;
  font-weight: 700;
  color: #1E293B;
  line-height: 1.2;
  margin-bottom: 2px;
}

.category-item-sub {
  font-size: 9px;
  font-weight: 500;
  color: #64748B;
  line-height: 1.2;
}

/* ─── 4. SECTION HEADINGS ─── */
.section-block {
  margin-bottom: 26px;
  padding: 0 16px;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 14px;
}

.title-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sec-title {
  font-size: 16px;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.2px;
}

.sec-subtitle {
  font-size: 11.5px;
  font-weight: 400;
  color: #64748B;
}

.see-all-btn {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 4px 8px;
  border-radius: 8px;
  background: rgba(99, 102, 241, 0.08);
}

.see-all-text {
  font-size: 11.5px;
  font-weight: 700;
  color: #4F46E5;
}

.see-all-arrow {
  font-size: 14px;
  font-weight: 700;
  color: #4F46E5;
}

/* ─── 5. SECTION 1: FEATURED EVENTS HORIZONTAL SCROLL ─── */
.featured-events-scroll {
  width: 100%;
  overflow-x: scroll;
  margin-left: -16px;
  margin-right: -16px;
  padding-left: 16px;
  padding-right: 16px;
  box-sizing: border-box;
}

.featured-events-row {
  display: flex;
  gap: 14px;
  width: max-content;
  padding-bottom: 6px;
}

.featured-event-card {
  width: 250px;
  background: #FFFFFF;
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid #E2E8F0;
  box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.06);
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.featured-event-card:active {
  transform: scale(0.98);
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 140px;
  background: #E2E8F0;
  overflow: hidden;
}

.card-thumb-img {
  width: 100%;
  height: 100%;
}

.card-thumb-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.75) 100%);
}

.card-tag-pill {
  position: absolute;
  top: 10px;
  left: 10px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(15, 23, 42, 0.75);
  padding: 4px 9px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.tag-icon {
  font-size: 11px;
}

.tag-label {
  color: #FFFFFF;
  font-size: 10.5px;
  font-weight: 700;
}

.card-price-overlay {
  position: absolute;
  bottom: 10px;
  left: 10px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  z-index: 2;
}

.price-prefix {
  color: rgba(255, 255, 255, 0.85);
  font-size: 9.5px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.price-val-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.price-val {
  color: #FFFFFF;
  font-size: 14.5px;
  font-weight: 800;
}

.price-strike {
  color: rgba(255, 255, 255, 0.65);
  font-size: 10px;
  text-decoration: line-through;
}

.featured-card-body {
  padding: 12px 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.featured-event-name {
  font-size: 13.5px;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 36px;
}

.event-meta-pill-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-mini-pill {
  display: flex;
  align-items: center;
  gap: 5px;
}

.meta-mini-icon {
  font-size: 11px;
  flex-shrink: 0;
}

.meta-mini-text {
  font-size: 11px;
  color: #64748B;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

/* ─── 6. SECTION 2: TOKO UMKM BINAAN BNI ─── */
.stores-showcase-scroll {
  width: 100%;
  overflow-x: scroll;
  margin-left: -16px;
  margin-right: -16px;
  padding-left: 16px;
  padding-right: 16px;
  box-sizing: border-box;
}

.stores-showcase-row {
  display: flex;
  gap: 12px;
  width: max-content;
  padding-bottom: 6px;
}

.store-showcase-card {
  width: 220px;
  background: #FFFFFF;
  border-radius: 18px;
  padding: 14px;
  border: 1px solid #E2E8F0;
  box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.05);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.store-card-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.store-card-logo {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1px solid #E2E8F0;
  background: #F1F5F9;
  flex-shrink: 0;
}

.store-card-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
}

.store-name-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.store-name-text {
  font-size: 13px;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.store-official-badge {
  font-size: 10px;
  color: #FFFFFF;
  background: #0EA5E9;
  border-radius: 50%;
  width: 14px;
  height: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.store-city-text {
  font-size: 11px;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.store-mini-products {
  display: flex;
  gap: 8px;
  background: #F8FAFC;
  border-radius: 12px;
  padding: 8px;
}

.store-mini-prod-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  overflow: hidden;
}

.mini-prod-img {
  width: 100%;
  height: 60px;
  border-radius: 8px;
  background: #E2E8F0;
}

.mini-prod-price {
  font-size: 10px;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.store-visit-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11.5px;
  font-weight: 700;
  color: #0D9488;
  background: #F0FDFA;
  padding: 8px 12px;
  border-radius: 10px;
}

.cta-arrow {
  font-size: 11px;
}

/* ─── 7. SECTION 3: PRODUK UMKM PILIHAN (2-COL GRID) ─── */
.products-grid-2col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.product-card-item {
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #E2E8F0;
  box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
}

.prod-img-wrap {
  position: relative;
  width: 100%;
  height: 140px;
  background: #F1F5F9;
}

.prod-img {
  width: 100%;
  height: 100%;
}

.prod-stock-pill {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: rgba(15, 23, 42, 0.7);
  color: #FFFFFF;
  font-size: 9px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 6px;
}

.prod-body {
  padding: 10px 12px 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.prod-name {
  font-size: 12.5px;
  font-weight: 700;
  color: #0F172A;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 32px;
}

.prod-price {
  font-size: 13px;
  font-weight: 800;
  color: #EA580C;
}

.prod-category {
  font-size: 10px;
  color: #94A3B8;
  font-weight: 500;
}

/* ─── 8. SECTION 4: UNIVERSAL EVENT DIRECTORY & FILTER CHIPS ─── */
.filter-chips-scroll {
  width: 100%;
  overflow-x: scroll;
  margin-left: -16px;
  margin-right: -16px;
  padding-left: 16px;
  padding-right: 16px;
  box-sizing: border-box;
  margin-bottom: 14px;
}

.filter-chips-row {
  display: flex;
  gap: 8px;
  width: max-content;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 20px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.filter-chip.active {
  background: #0F172A;
  border-color: #0F172A;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
}

.chip-icon {
  font-size: 12px;
}

.chip-label {
  font-size: 11.5px;
  font-weight: 600;
  color: #475569;
}

.filter-chip.active .chip-label {
  color: #FFFFFF;
}

.events-vertical-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.event-list-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #E2E8F0;
  box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.05);
  padding: 10px;
  gap: 12px;
}

.event-list-thumb {
  width: 96px;
  height: 96px;
  border-radius: 12px;
  flex-shrink: 0;
  background: #E2E8F0;
}

.event-list-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.list-tag-row {
  display: flex;
  align-items: center;
}

.list-category-tag {
  font-size: 9.5px;
  font-weight: 700;
  color: #4F46E5;
  background: #EEF2FF;
  padding: 2px 7px;
  border-radius: 6px;
}

.list-event-name {
  font-size: 13px;
  font-weight: 700;
  color: #0F172A;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.list-meta-row {
  display: flex;
  align-items: center;
  gap: 5px;
}

.list-meta-text {
  font-size: 10.5px;
  color: #64748B;
  font-weight: 500;
}

.list-meta-loc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  flex: 1;
}

.list-meta-dot {
  color: #CBD5E1;
  font-size: 10px;
}

.list-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-price-val {
  font-size: 13px;
  font-weight: 800;
  color: #0F172A;
}

.list-buy-btn {
  font-size: 11px;
  font-weight: 700;
  color: #FFFFFF;
  background: #0F172A;
  padding: 5px 10px;
  border-radius: 8px;
}

/* ─── 9. EMPTY STATE & FOOTER ─── */
.empty-state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
  background: #FFFFFF;
  border-radius: 16px;
  border: 1px dashed #CBD5E1;
}

.empty-icon {
  font-size: 36px;
  margin-bottom: 10px;
}

.empty-title {
  font-size: 14px;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 4px;
}

.empty-desc {
  font-size: 11.5px;
  color: #64748B;
  line-height: 1.4;
}

.landing-footer {
  padding: 20px 16px 40px;
  text-align: center;
}

.footer-secured-badge {
  font-size: 10.5px;
  color: #94A3B8;
  line-height: 1.5;
  font-weight: 500;
}

/* ─── 10. SKELETON LOADERS ─── */
.shimmer-container {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.shimmer-section-head {
  height: 24px;
  width: 45%;
  border-radius: 8px;
}

.shimmer-card-row {
  display: flex;
  gap: 12px;
}

.shimmer-card-item {
  flex: 1;
  height: 160px;
  border-radius: 16px;
}

.shimmer-list-item {
  height: 90px;
  border-radius: 16px;
}

.skeleton {
  background: linear-gradient(
    90deg,
    #F1F5F9 25%,
    #E2E8F0 50%,
    #F1F5F9 75%
  );
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}
