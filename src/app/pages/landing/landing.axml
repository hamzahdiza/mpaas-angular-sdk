<view class="sticky-top">
  <top-bar
    type="{{'navigation'}}"
    navigate={{true}}
    backgroundColor="#9B7EDC"
    color="#FFFFFF"
    title="{{'Partner Menu'}}"
    iconL="../../../assets/icons/ic_common_arrow_back_white.svg"
    safeArea
    pixel
  />
</view>

<view class="{{ errorReload == 0 ? 'base-background-0' : 'base-background'}}"></view>

<scroll-view
  a:if="{{ errorReload == 0 }}"
  scroll-y="{{true}}"
  style="height:calc(100vh - 56px - {{statusBarHeight}}px);"
  onScroll="onScroll"
  class="scroll-container"
>

  <view class="background-content-base"></view>

  <!-- HERO HEADER -->
  <view class="main-hero-header">
    <view class="hero-header">
      <image mode="widthFix" class="landing-image-left" src="../../../assets/images/lifestyle-header-left-images.svg" />
      <image mode="widthFix" class="landing-image-right" src="../../../assets/images/lifestyle-header-right-images.svg" />
      <view class="header-content">
        <view a:if="{{ isLoading }}" class="header-content-left">
          <text class="header-content-title-loading skeleton" />
          <text class="header-content-description-loading skeleton" />
        </view>
        <view a:else class="header-content-left">
          <text class="header-content-title">{{lang.lifestyleLandingPageScreenTitleLabel}}</text>
          <text class="header-content-description">{{lang.lifestyleLandingPageScreenSubTitleLabel}}</text>
        </view>
      </view>
    </view>
    <view class="color-base-hero-header"></view>
  </view>

  <!-- ═══════════════════════════════════════════ -->
  <!-- QUICK ACCESS PILLS — horizontal scroll      -->
  <!-- ═══════════════════════════════════════════ -->
  <view class="quick-access-section">
    <view class="section-header">
      <text class="section-header-label">Kategori</text>
    </view>
    <scroll-view scroll-x="{{true}}" class="quick-pills-scroll">
      <view class="quick-pills-row">

        <block a:for="{{ uniqueCategories }}" a:for-index="index" a:for-item="item" a:if="{{ !isLoading }}">
          <view class="quick-pill" onTap="{{item.onTap}}" data-category="{{item.name}}">
            <view class="quick-pill-icon quick-pill-icon--{{item.theme}}">
              <image class="quick-pill-img" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <text class="quick-pill-label">{{item.name}}</text>
          </view>
        </block>

        <!-- loading pills -->
        <block a:for="{{ loadingArr }}" a:if="{{ isLoading }}">
          <view class="quick-pill">
            <view class="quick-pill-icon skeleton" style="width:60px;height:60px;border-radius:20px;"></view>
            <text class="quick-pill-label skeleton" style="width:40px;height:12px;border-radius:4px;margin-top:4px;"></text>
          </view>
        </block>

      </view>
    </scroll-view>
  </view>

  <!-- ═══════════════════════════════════════════ -->
  <!-- SECTION: Semua Layanan — 2-col grid         -->
  <!-- ═══════════════════════════════════════════ -->
  <view a:if="{{ allRunning.length > 0 }}" class="services-section">
    <view class="section-header">
      <text class="section-header-label">Event Seru Untukmu 📢</text>
    </view>

    <scroll-view scroll-x="{{true}}" class="quick-pills-scroll">
      <view class="quick-pills-row">

        <block a:if="{{ allRunning }}" a:for="{{ allRunning }}" a:for-index="idx" a:for-item="event" >
          <view class="event-card-section" onTap="goToRunningIndex" data-runningData="{{event}}" id="{{'event-card-' + event.id}}">
            <view class="event-banner-wrapper">
              
              <image
                class="event-banner-img"
                mode="scaleToFill"
                src="{{event.bannerUrl}}"
                data-index="{{idx}}"
              />
              <view class="event-price-badge">
                <text class="event-price-badge-label">Mulai dari</text>
                <text class="event-price-badge-amount">{{event.formattedPrice}}</text>
              </view>
            </view>
            <view class="event-info">
              <text class="event-name">{{event.name}}</text>
              <view class="event-meta">
                <view class="event-meta-row">
                  <image class="event-meta-icon" src="../../../assets/icons/ic_common_calendar_today.svg" mode="scaleToFill" />
                  <text class="event-meta-text">{{event.formattedDate}}</text>
                </view>
                <view class="event-meta-row">
                  <image class="event-meta-icon" src="../../../assets/icons/ic_common_location.svg" mode="scaleToFill" />
                  <text class="event-meta-text">{{event.location}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
        <!-- Hotel
        <view class="service-card theme-blue" id="lifestyle-landing-page-hotel-list" onTap="goToHotelIndex">
          <view class="service-card-img">
            <image class="service-card-icon" src="../../../assets/icons/ic_hotel_primary.svg" mode="aspectFit" />
          </view>
          <view class="service-card-body">
            <view class="service-card-tag service-tag-blue">Travel</view>
            <text class="service-card-title">{{lang.lifestyleLandingHotelTitleLabel || 'Reservasi Hotel'}}</text>
            <text class="service-card-sub">{{lang.lifestyleLandingHotelDescLabel || 'Penginapan terbaik untuk liburanmu'}}</text>
          </view>
        </view>

        <!-- Cafe -->
        <!-- <view class="service-card theme-green" id="lifestyle-landing-page-cafe-list" onTap="goToCafeIndex">
          <view class="service-card-img">
            <image class="service-card-icon" src="../../../assets/icons/ic_common_entertainment.svg" mode="aspectFit" />
          </view>
          <view class="service-card-body">
            <view class="service-card-tag service-tag-green">Kuliner</view>
            <text class="service-card-title">Cafe</text>
            <text class="service-card-sub">Suasana nyaman, menu cafe favorit</text>
          </view>
        </view> -->

        <!-- Restoran -->
        <!-- <view class="service-card theme-amber" id="lifestyle-landing-page-restaurant-list" onTap="goToRestaurantIndex">
          <view class="service-card-img">
            <image class="service-card-icon" src="../../../assets/icons/ic_common_location.svg" mode="aspectFit" />
          </view>
          <view class="service-card-body">
            <view class="service-card-tag service-tag-amber">Kuliner</view>
            <text class="service-card-title">Restoran</text>
            <text class="service-card-sub">Reservasi & pemesanan menu keluarga</text>
          </view>
        </view> --> 

        <!-- Partner cards dari API
        <block a:for="{{ dataPartner }}" a:for-index="index" a:for-item="item" a:if="{{ !isLoading }}">
          <view
            class="service-card theme-purple"
            id="{{'lifestyle-landing-page-screen-card-' + item.partnerTitle}}"
            onTap="goToPartnerWebview"
            data-selectedPartner="{{item}}"
          >
            <view class="service-card-img">
              <view a:if="{{ item.isImageLoading }}" class="service-card-img-skeleton skeleton"></view>
              <view
                class="service-card-cover"
                style="background-image: url('{{item.pertnerDisplayImage}}'); {{item.isImageLoading ? 'display:none' : ''}}"
                data-index="{{index}}"
              ></view>
              <image
                class="service-card-cover"
                mode="scaleToFill"
                src="{{item.pertnerDisplayImage}}"
                style="display:none"
                data-index="{{index}}"
                onLoad="imageLoad"
              />
            </view>
            <view class="service-card-body">
              <view class="service-card-tag service-tag-purple">{{item.partnerCategory}}</view>
              <text class="service-card-title">{{lang[item.partnerTitle]}}</text>
              <text class="service-card-sub">{{lang[item.partnerDescription]}}</text>
            </view>
          </view>
        </block> -->

        <!-- Loading skeleton cards -->
        <block a:for="{{ loadingArr }}" a:if="{{ isEventsLoading }}">
          <view class="service-card skeleton">
            <view class="service-card-img"></view>
            <view class="service-card-body">
              <view style="width:48px;height:14px;border-radius:4px;background:#e0e0e0;margin-bottom:6px;"></view>
              <view style="width:80px;height:14px;border-radius:4px;background:#e0e0e0;margin-bottom:4px;"></view>
              <view style="width:100%;height:22px;border-radius:4px;background:#e0e0e0;"></view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view a:if="{{ allHotels.length > 0 }}" class="services-section">
    <view class="section-header">
      <text class="section-header-label">Hotel Favorit✨</text>
    </view>
    <scroll-view scroll-x="{{true}}" class="quick-pills-scroll">
      <view class="quick-pills-row">
        
        <block a:for="{{ allHotels }}" a:for-index="idx" a:for-item="event" a:if="{{ !isEventsLoading }}">
          <view class="event-card-section" onTap="goToHotelIndex" data-event="{{event}}" id="{{'event-card-' + event.id}}">
            <view class="event-banner-wrapper">
              <view a:if="{{ event.isImageLoading }}" class="event-banner-skeleton skeleton"></view>
              <image
                class="event-banner-img"
                mode="scaleToFill"
                src="{{event.bannerUrl}}"
                data-index="{{idx}}"
                onLoad="eventImageLoad"
              />
              <!-- <view class="event-price-badge">
                <text class="event-price-badge-label">Mulai dari</text>
                <text class="event-price-badge-amount">{{event.formattedPrice}}</text>
              </view> -->
            </view>
            <view class="event-info">
              <text class="event-name">{{event.name}}</text>
              <view class="event-meta">
                <!-- <view class="event-meta-row">
                  <image class="event-meta-icon" src="../../../assets/icons/ic_common_calendar_today.svg" mode="scaleToFill" />
                  <text class="event-meta-text">{{event.formattedDate}}</text>
                </view> -->
                <view class="event-meta-row">
                  <image class="event-meta-icon" src="../../../assets/icons/ic_common_location.svg" mode="scaleToFill" />
                  <text class="event-meta-text">{{event.location}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
          <!-- Loading skeleton cards -->
          <block a:for="{{ loadingArr }}" a:if="{{ isEventsLoading }}">
            <view class="service-card skeleton">
              <view class="service-card-img"></view>
              <view class="service-card-body">
                <view style="width:48px;height:14px;border-radius:4px;background:#e0e0e0;margin-bottom:6px;"></view>
                <view style="width:80px;height:14px;border-radius:4px;background:#e0e0e0;margin-bottom:4px;"></view>
                <view style="width:100%;height:22px;border-radius:4px;background:#e0e0e0;"></view>
              </view>
            </view>
          </block>
      </view>
    </scroll-view>
    
  </view>



  <!-- ALL EVENTS SECTION -->
  <view  class="events-section">
    <view class="section-header">
      <text class="section-header-label">Upcoming Events 📅</text>
    </view>
    <view class="events-list">
      <block a:for="{{ allEvents }}" a:for-index="idx" a:for-item="event" a:if="{{ !isEventsLoading }}">
        <view class="event-card" onTap="goToEventDetail" data-event="{{event}}" id="{{'event-card-' + event.id}}">
          <view class="event-banner-wrapper">
            <view a:if="{{ event.isImageLoading }}" class="event-banner-skeleton skeleton"></view>
            <image
              class="event-banner-img"
              mode="scaleToFill"
              src="{{event.bannerUrl}}"
              data-index="{{idx}}"
              onLoad="eventImageLoad"
              style="{{ event.isImageLoading ? 'opacity:0' : 'opacity:1' }}"
            />
            <view class="event-price-badge">
              <text class="event-price-badge-label">Mulai dari</text>
              <text class="event-price-badge-amount">{{event.formattedPrice}}</text>
              <text a:if="{{event.formattedNormalPrice}}" class="event-price-badge-strike" style="text-decoration: line-through; color: rgba(255,255,255,0.7); font-size: 10px; margin-left: 4px;">{{event.formattedNormalPrice}}</text>
            </view>
          </view>
          <view class="event-info">
            <text class="event-name">{{event.name}}</text>
            <view class="event-meta">
              <view class="event-meta-row">
                <image class="event-meta-icon" src="../../../assets/icons/ic_common_calendar_today.svg" mode="scaleToFill" />
                <text class="event-meta-text">{{event.formattedDate}}</text>
              </view>
              <view class="event-meta-row">
                <image class="event-meta-icon" src="../../../assets/icons/ic_common_location.svg" mode="scaleToFill" />
                <text class="event-meta-text">{{event.location}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <block a:for="{{ eventsLoadingArr }}" a:if="{{ isEventsLoading }}">
        <view class="event-card">
          <view class="event-banner-wrapper skeleton" style="height:180px;"></view>
          <view class="event-info">
            <text class="event-name skeleton" style="width:80%;height:18px;min-height:18px;margin-bottom:8px;"></text>
            <view class="event-meta">
              <view class="event-meta-row skeleton" style="width:60%;height:14px;min-height:14px;margin-bottom:6px;"></view>
              <view class="event-meta-row skeleton" style="width:70%;height:14px;min-height:14px;"></view>
            </view>
          </view>
        </view>
      </block>

      <view a:if="{{ !isEventsLoading && allEvents.length == 0 }}" class="events-empty">
        <image class="events-empty-icon" src="../../../assets/icons/ic_common_illustration_failed.svg" />
        <text class="events-empty-text">Belum ada event tersedia</text>
      </view>
    </view>
  </view>

  <!-- TNC -->
  <view class="tnc-container">
    <text class="tnc-main-text">
      {{lang.lifestyleLandingPageScreenTncFirstLabel}}
      <text onTap="goToTnc" class="tnc-hightlight-text">
        &nbsp;{{lang.lifestyleLandingPageScreenTncMiddleLabel}}&nbsp;
      </text> {{lang.lifestyleLandingPageScreenTncLastLabel}}
    </text>
  </view>

</scroll-view>

<!-- Failed Get Data -->
<view a:if="{{ !isLoading && errorReload == 2 }}" class="transaction-history-body-prompt">
  <image class="image-illustration" src="../../../assets/icons/ic_common_illustration_failed.svg" />
  <text class="txt-h3-px mg-t-24-px">{{ lang.lifestyleTransactionHistoryFailedToLoadScreenTitleLabel }}</text>
  <text class="txt-center txt-body2-px mg-t-16-px">{{ lang.lifestyleTransactionHistoryFailedToLoadScreenDescLabel }}</text>
  <view id="btn-reload" class="mg-t-32-px d-f-row jc-center ai-center" onTap="handleRequest">
    <image class="mg-r-8-px icon-size-48" src="../../../assets/icons/ic_common_refresh.svg" />
    <text class="txt-h5-px txt-orange-300">{{ lang.lifestyleTransactionHistoryFailedToLoadScreenRetryButtonLabel }}</text>
  </view>
</view>

<popup visible="{{isShowLottery && !isLoading && errorReload == 0}}">
  <view class="container-content-comp-modal">
    <view class="comp-title">
      <image mode="scaleToFill" class="comp-image-error" src="/src/assets/icons/ic_common_error_filled.svg" />
      <text class="comp-title-text">{{lang["lifestyleLandingPageScreenNoSOFModalTitleLabel"]}}</text>
    </view>
    <view class="comp-description">
      <text class="comp-description-text">{{lang["lifestyleLandingPageScreenNoSOFModalDescLabel"]}}</text>
    </view>
  </view>
  <view>
    <bni-button pixel class="local-primary-btn" onTap="closeModal">
      {{lang["lifestyleLandingPageScreenNoSOFModalOpenSavingAccountButton"]}}
    </bni-button>
  </view>
</popup>
<loading loading="{{ isLoading }}" />

<feature-modal></feature-modal>
<error-internet></error-internet>
<general-error></general-error>
