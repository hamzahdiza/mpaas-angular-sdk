<view class="landing-page-root">
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- TOP APP BAR                                                 -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <view class="sticky-nav">
    <top-bar
      type="primary"
      navigate="{{true}}"
      backgroundColor="#0F172A"
    />
    <top-bar
      type="navigation"
      navigate="{{true}}"
      backgroundColor="#0F172A"
      color="#FFFFFF"
      title="Wondr Lifestyle"
      iconL="/src/assets/icons/ic_common_arrow_back_white.svg"
      exit
      iconR="/src/assets/icons/Icon_transaction_history_white.svg"
      onIconRTap="goToTransactionHistory"
      safeArea="{{true}}"
      pixel="{{true}}"
    />
  </view>

  <scroll-view
    scroll-y="{{true}}"
    class="landing-scroll-body"
    style="height: calc(100vh - 56px - {{statusBarHeight}}px);"
  >
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- HERO DISCOVERY BANNER & SEARCH                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <view class="hero-wrapper">
      <view class="hero-mesh-bg" />
      <view class="hero-content">
        <view class="hero-tag-pill">
          <text class="hero-tag-dot">●</text>
          <text class="hero-tag-text">BNI Lifestyle Hub</text>
        </view>
        <text class="hero-headline">Jelajahi Event & Produk Pilihan</text>
        <text class="hero-subtext">Temukan tiket konser, olahraga, pameran, serta ragam produk UMKM unggulan binaan BNI.</text>

        <!-- Search Bar -->
        <view class="search-bar-box">
          <text class="search-icon">🔍</text>
          <input
            class="search-input"
            placeholder="Cari event, konser, atau toko UMKM..."
            placeholder-class="search-placeholder"
            value="{{searchQuery}}"
            onInput="onSearchInput"
          />
        </view>
      </view>
    </view>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- MAIN CATEGORY HUB (4 PRIMARY HUBS)                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <view class="category-hub-card">
      <view class="category-hub-grid">
        <block a:for="{{ quickCategories }}" a:key="id">
          <view class="category-hub-item" onTap="{{item.onTap}}">
            <view class="category-icon-wrap {{item.theme}}">
              <image class="category-icon-img" src="{{item.icon}}" mode="aspectFit" />
              <text class="category-badge {{item.badgeColor}}" a:if="{{item.badge}}">{{item.badge}}</text>
            </view>
            <text class="category-item-title">{{item.name}}</text>
            <text class="category-item-sub">{{item.subtitle}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SHIMMER LOADING STATE                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <view a:if="{{ isLoading }}" class="shimmer-container">
      <view class="shimmer-section-head skeleton" />
      <view class="shimmer-card-row">
        <view class="shimmer-card-item skeleton" />
        <view class="shimmer-card-item skeleton" />
      </view>
      <view class="shimmer-section-head skeleton" style="margin-top: 24px;" />
      <view class="shimmer-list-item skeleton" />
      <view class="shimmer-list-item skeleton" />
    </view>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- LOADED CONTENT                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <block a:else>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- SECTION: MPAAS CONVERTER BENCHMARK & CONVERGENCE SUITE    -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="section-block suite-section-block">
        <view class="section-title-row">
          <view class="title-left">
            <view class="suite-tag-pill">
              <text class="suite-tag-icon">⚡</text>
              <text class="suite-tag-text">MPAAS CONVERTER BENCHMARK</text>
            </view>
            <text class="sec-title">Convergence & RnD Testing Suites</text>
            <text class="sec-subtitle">Uji coba terpadu komponen mpaas-library, pipeline native, dan grafik finansial</text>
          </view>
        </view>

        <!-- 3 Interactive Convergence Cards Grid -->
        <view class="suite-cards-grid">
          
          <!-- Card 1: Charts & Financial Analytics -->
          <view class="suite-card-item card-theme-indigo" onTap="goToChartsShowcase">
            <view class="suite-card-header">
              <view class="suite-card-icon-wrap icon-indigo">
                <text class="suite-icon">📊</text>
              </view>
              <text class="suite-card-badge badge-indigo">Gold & Yearly</text>
            </view>
            <text class="suite-card-title">Grafik & Visualisasi Finansial</text>
            <text class="suite-card-desc">Gold Line Chart (AntV F2), Canvas Doughnut Diagram, Bar Chart, & Year-End Cashflow Review.</text>
            <view class="suite-card-footer">
              <text class="suite-card-meta">4 Jenis Visualisasi</text>
              <text class="suite-card-arrow">Buka Grafik ›</text>
            </view>
          </view>

          <!-- Card 2: BNI mPaaS Design System & Components -->
          <view class="suite-card-item card-theme-teal" onTap="goToComponentLibrary">
            <view class="suite-card-header">
              <view class="suite-card-icon-wrap icon-teal">
                <text class="suite-icon">🧩</text>
              </view>
              <text class="suite-card-badge badge-teal">mpaas-library</text>
            </view>
            <text class="suite-card-title">Koleksi Komponen UI mPaaS</text>
            <text class="suite-card-desc">37+ Komponen UI resmi BNI (Button, Input, Steps, Popup, Story, Swipe Card, Calendar Picker, dll).</text>
            <view class="suite-card-footer">
              <text class="suite-card-meta">37+ Komponen UI</text>
              <text class="suite-card-arrow">Buka Katalog ›</text>
            </view>
          </view>

          <!-- Card 3: mPaaS & Native RnD Pipeline -->
          <view class="suite-card-item card-theme-amber" onTap="goToTestPipeline">
            <view class="suite-card-header">
              <view class="suite-card-icon-wrap icon-amber">
                <text class="suite-icon">🧪</text>
              </view>
              <text class="suite-card-badge badge-amber">mpaas-test-pipeline</text>
            </view>
            <text class="suite-card-title">mPaaS & Native RnD Pipeline</text>
            <text class="suite-card-desc">25+ Pengujian Native & JSAPI: Digital Signature, Maps, QR Code, PDF Render, Session, & Keamanan.</text>
            <view class="suite-card-footer">
              <text class="suite-card-meta">25+ Modul Uji Coba</text>
              <text class="suite-card-arrow">Buka Pipeline ›</text>
            </view>
          </view>

        </view>
      </view>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- SECTION 1: FEATURED & TRENDING EVENTS                      -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="section-block" a:if="{{ highlightEvents.length > 0 }}">
        <view class="section-title-row">
          <view class="title-left">
            <text class="sec-title">Event Pilihan & Populer</text>
            <text class="sec-subtitle">Tiket konser, olahraga, dan festival terbaik</text>
          </view>
          <view class="see-all-btn" onTap="goToAllEvents">
            <text class="see-all-text">Lihat Semua</text>
            <text class="see-all-arrow">›</text>
          </view>
        </view>

        <!-- Horizontal Snap Card Scroll -->
        <scroll-view scroll-x="{{true}}" class="featured-events-scroll">
          <view class="featured-events-row">
            <block a:for="{{ highlightEvents }}" a:key="id">
              <view class="featured-event-card" onTap="goToEventDetail" data-event="{{item}}">
                <view class="card-thumb-wrap">
                  <image class="card-thumb-img" src="{{item.bannerUrl}}" mode="aspectFill" />
                  <view class="card-thumb-gradient" />
                  
                  <!-- Top Badges -->
                  <view class="card-tag-pill">
                    <text class="tag-icon">{{item.categoryIcon}}</text>
                    <text class="tag-label">{{item.categoryTag}}</text>
                  </view>

                  <!-- Bottom Price Pill -->
                  <view class="card-price-overlay">
                    <text class="price-prefix">Mulai dari</text>
                    <view class="price-val-row">
                      <text class="price-val">{{item.formattedPrice}}</text>
                      <text class="price-strike" a:if="{{item.formattedNormalPrice}}">{{item.formattedNormalPrice}}</text>
                    </view>
                  </view>
                </view>

                <!-- Card Body -->
                <view class="featured-card-body">
                  <text class="featured-event-name">{{item.name}}</text>
                  <view class="event-meta-pill-row">
                    <view class="meta-mini-pill">
                      <text class="meta-mini-icon">📅</text>
                      <text class="meta-mini-text">{{item.formattedDate}}</text>
                    </view>
                    <view class="meta-mini-pill">
                      <text class="meta-mini-icon">📍</text>
                      <text class="meta-mini-text">{{item.location}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- SECTION 2: TOKO UMKM BINAAN BNI                             -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="section-block" a:if="{{ umkmStores.length > 0 }}">
        <view class="section-title-row">
          <view class="title-left">
            <text class="sec-title">Mall UMKM Binaan BNI</text>
            <text class="sec-subtitle">Katalog produk autentik langsung dari mitra pengrajin</text>
          </view>
          <view class="see-all-btn" onTap="goToUmkmMall">
            <text class="see-all-text">Kunjungi Mall</text>
            <text class="see-all-arrow">›</text>
          </view>
        </view>

        <!-- Horizontal Stores Showcase -->
        <scroll-view scroll-x="{{true}}" class="stores-showcase-scroll">
          <view class="stores-showcase-row">
            <block a:for="{{ umkmStores }}" a:key="id">
              <view class="store-showcase-card" onTap="goToUmkmStore" data-store="{{item}}">
                <!-- Store Header -->
                <view class="store-card-header">
                  <image class="store-card-logo" src="{{item.logoUrl}}" mode="aspectFill" />
                  <view class="store-card-info">
                    <view class="store-name-row">
                      <text class="store-name-text">{{item.name}}</text>
                      <text class="store-official-badge">✓</text>
                    </view>
                    <text class="store-city-text">📍 {{item.cityName}}</text>
                  </view>
                </view>

                <!-- Store Preview Products -->
                <view class="store-mini-products" a:if="{{ item.previewProducts && item.previewProducts.length > 0 }}">
                  <block a:for="{{ item.previewProducts }}" a:for-item="prod" a:key="id">
                    <view class="store-mini-prod-item">
                      <image class="mini-prod-img" src="{{prod.firstImage}}" mode="aspectFill" />
                      <text class="mini-prod-price">{{prod.priceDisplay}}</text>
                    </view>
                  </block>
                </view>

                <view class="store-visit-cta">
                  <text>Kunjungi Toko</text>
                  <text class="cta-arrow">➔</text>
                </view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- SECTION 3: PRODUK UMKM PILIHAN                              -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="section-block" a:if="{{ umkmProducts.length > 0 }}">
        <view class="section-title-row">
          <view class="title-left">
            <text class="sec-title">Produk UMKM Pilihan</text>
            <text class="sec-subtitle">Koleksi batik, fashion, kerajinan, & kuliner</text>
          </view>
          <view class="see-all-btn" onTap="goToUmkmMall">
            <text class="see-all-text">Lihat Semua</text>
            <text class="see-all-arrow">›</text>
          </view>
        </view>

        <!-- 2-Column Product Grid -->
        <view class="products-grid-2col">
          <block a:for="{{ umkmProducts }}" a:key="id">
            <view class="product-card-item" onTap="goToUmkmProductDetail" data-product="{{item}}">
              <view class="prod-img-wrap">
                <image class="prod-img" src="{{item.firstImage}}" mode="aspectFill" />
                <view class="prod-stock-pill" a:if="{{ item.stock > 0 }}">
                  <text>Stok {{item.stock}}</text>
                </view>
              </view>
              <view class="prod-body">
                <text class="prod-name">{{item.name}}</text>
                <text class="prod-price">{{item.priceDisplay}}</text>
                <text class="prod-category">{{item.categoryName || 'UMKM Lokal'}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- SECTION 4: UNIVERSAL EVENT DIRECTORY & FILTER CHIPS         -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="section-block">
        <view class="section-title-row">
          <view class="title-left">
            <text class="sec-title">Agenda Event Mendatang</text>
            <text class="sec-subtitle">Pilih kategori event sesuai minatmu</text>
          </view>
          <view class="see-all-btn" onTap="goToAllEvents">
            <text class="see-all-text">Katalog Event</text>
            <text class="see-all-arrow">›</text>
          </view>
        </view>

        <!-- Dynamic Filter Chips -->
        <scroll-view scroll-x="{{true}}" class="filter-chips-scroll">
          <view class="filter-chips-row">
            <block a:for="{{ eventFilterCategories }}" a:key="id">
              <view
                class="filter-chip {{ selectedEventFilter === item.id ? 'active' : '' }}"
                onTap="filterEventsByCategory"
                data-id="{{item.id}}"
              >
                <text class="chip-icon">{{item.icon}}</text>
                <text class="chip-label">{{item.label}}</text>
              </view>
            </block>
          </view>
        </scroll-view>

        <!-- Event List -->
        <view class="events-vertical-list">
          <block a:for="{{ filteredEvents }}" a:key="id">
            <view class="event-list-card" onTap="goToEventDetail" data-event="{{item}}">
              <image class="event-list-thumb" src="{{item.bannerUrl}}" mode="aspectFill" />
              <view class="event-list-body">
                <view class="list-tag-row">
                  <text class="list-category-tag">{{item.categoryTag}}</text>
                </view>
                <text class="list-event-name">{{item.name}}</text>
                <view class="list-meta-row">
                  <text class="list-meta-text">📅 {{item.formattedDate}}</text>
                  <text class="list-meta-dot">•</text>
                  <text class="list-meta-text list-meta-loc">📍 {{item.location}}</text>
                </view>
                <view class="list-price-row">
                  <text class="list-price-val">{{item.formattedPrice}}</text>
                  <view class="list-buy-btn">Beli Tiket ›</view>
                </view>
              </view>
            </view>
          </block>

          <!-- Empty State -->
          <view a:if="{{ filteredEvents.length === 0 }}" class="empty-state-box">
            <text class="empty-icon">🎪</text>
            <text class="empty-title">Tidak Ada Event Ditemukan</text>
            <text class="empty-desc">Coba ubah kata kunci pencarian atau pilih kategori lainnya.</text>
          </view>
        </view>
      </view>

      <!-- ═════════════════════════════════════════════════════════ -->
      <!-- FOOTER NOTE & T&C                                           -->
      <!-- ═════════════════════════════════════════════════════════ -->
      <view class="landing-footer">
        <text class="footer-secured-badge">🛡️ Transaksi Terenkripsi & Dijamin Aman oleh PT Bank Negara Indonesia (Persero) Tbk</text>
      </view>

    </block>
  </scroll-view>
</view>
