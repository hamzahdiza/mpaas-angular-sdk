<view a:if="{{ successFetch }}" class="event-index-page">
  <view class="top-bar">
    <top-bar
      type="navigation"
      navigate
      safeArea
      pixel
      backgroundColor="#FFFFFF"
      title="{{detailEvent.name || detailEvent.eventName || 'Wondr Event'}}"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
    />
  </view>

  <!-- SDUI Dynamic Template Renderer (Renders Clean Card Theme, Navy Blue, Dark Slate, Crimson Maroon, or Studio Custom Templates) -->
  <sdui-dynamic-renderer
    eventData="{{detailEvent}}"
    onScreenChange="goToTicketList"
  />
</view>

<popup-image visible="{{isFullscreen}}" position="center" height="100vh" maskStyle="background-color: rgba(14, 14, 14, 0.80)">
  <view class="icon-close-fullscreen" onTap="popupPromoClose">
    <image class="icon-size-48" src="/src/assets/icons/ic_common_close_white.svg" />
  </view>
  <view class="image-fullscreen">
    <image class="zoomable-image" src="{{imageFullScreen}}" />
  </view>
</popup-image>

<view a:if="{{ !successFetch && !isLoading }}">
  <view class="top-bar">
    <top-bar
      type="navigation"
      navigate
      safeArea
      pixel
      backgroundColor="#FFFFFF"
      title="Wondr Event"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
    />
  </view>
  <error-reload
    reloadId="event-landing-page-screen-refresh"
    onReload="getLandingData"
    title="Gagal Memuat Data"
    desc="Silakan coba lagi"
  >
  </error-reload>
</view>

<loading pixel loading="{{ isLoading }}"></loading>
<feature-modal></feature-modal>
<error-internet></error-internet>
<general-error></general-error>