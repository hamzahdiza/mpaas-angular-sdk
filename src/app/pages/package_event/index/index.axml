<view class="event-detail-root" a:if="{{ successFetch }}">
  <view class="top-bar">
    <top-bar
      type="navigation"
      navigate
      safeArea
      pixel
      backgroundColor="#FFFFFF"
      title="{{detailEvent.name || detailEvent.eventName || 'Wondr Event'}}"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
      iconR="/src/assets/icons/Icon_transaction_history.svg"
      onIconRTap="goToTransactionHistory"
    />
  </view>

  <!-- SDUI Dynamic Template Renderer (Renders any template dynamically from DB schema) -->
  <sdui-dynamic-renderer
    eventData="{{detailEvent}}"
    onScreenChange="goToTicketList"
  />
</view>

<view a:if="{{ !successFetch && !isLoading }}">
  <view class="top-bar">
    <top-bar
      type="navigation"
      navigate
      safeArea
      pixel
      backgroundColor="#FFFFFF"
      title="Wondr Event"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
    />
  </view>
  <error-reload
    reloadId="event-landing-page-screen-refresh"
    onReload="getLandingData"
    title="Gagal Memuat Data"
    desc="Silakan coba lagi"
  >
  </error-reload>
</view>

<loading pixel loading="{{ isLoading }}"></loading>
<feature-modal></feature-modal>
<error-internet></error-internet>
<general-error></general-error>