.history-page-container {
  background-color: #F8FAFC;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.top-bar-wrapper {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: #FFFFFF;
  border-bottom: 1px solid #F1F5F9;
}

/* Nav Tabs */
.history-nav-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1px solid #E2E8F0;
  padding: 4px 16px 0;
  position: sticky;
  top: 56px;
  z-index: 40;
}

.nav-tab-item {
  flex: 1;
  text-align: center;
  padding: 10px 4px 12px;
  font-size: 13px;
  font-weight: 600;
  color: #64748B;
  border-bottom: 2px solid transparent;
  transition: all 0.2s;
  cursor: pointer;
}

.nav-tab-item.active {
  color: #F15A22;
  border-bottom-color: #F15A22;
  font-weight: 700;
}

.history-scroll-container {
  flex: 1;
  padding: 14px 16px 40px;
  box-sizing: border-box;
}

.transactions-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.transaction-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 16px;
  border: 1px solid #E2E8F0;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  display: flex;
  flex-direction: column;
  transition: transform 0.1s ease;
}

.transaction-card:active {
  transform: scale(0.995);
}

/* ═══════════════════════════════════════════════ */
/* UMKM ORDER CARD SPECIFICS                       */
/* ═══════════════════════════════════════════════ */
.card-store-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.store-badge-left {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  flex: 1;
}

.store-tiny-logo {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  object-fit: cover;
  border: 1px solid #E2E8F0;
  flex-shrink: 0;
}

.store-title-txt {
  font-size: 13px;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160px;
}

.umkm-pill-tag {
  background: #FFEDD5;
  color: #C2410C;
  font-size: 9px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  flex-shrink: 0;
}

.order-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: #94A3B8;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px dashed #F1F5F9;
}

.order-no-txt {
  font-family: monospace, sans-serif;
  color: #64748B;
  font-weight: 600;
}

.order-date-txt {
  color: #94A3B8;
}

/* Product Item Row */
.product-item-row {
  display: flex;
  gap: 12px;
  align-items: center;
}

.prod-thumbnail {
  width: 56px;
  height: 56px;
  border-radius: 10px;
  object-fit: cover;
  background: #F1F5F9;
  flex-shrink: 0;
  border: 1px solid #E2E8F0;
}

.prod-desc-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 3px;
  min-width: 0;
}

.prod-name-txt {
  font-size: 12px;
  font-weight: 600;
  color: #1E293B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.prod-variant-txt {
  font-size: 10px;
  color: #64748B;
  background-color: #F1F5F9;
  padding: 1px 6px;
  border-radius: 4px;
  align-self: flex-start;
}

.prod-qty-price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 2px;
}

.prod-price-txt {
  font-size: 13px;
  font-weight: 700;
  color: #0F172A;
}

.prod-qty-txt {
  font-size: 11px;
  color: #94A3B8;
}

.more-items-notice {
  margin-top: 8px;
  padding: 4px 8px;
  background: #F8FAFC;
  border-radius: 6px;
  font-size: 10px;
  color: #64748B;
  text-align: center;
}

/* Courier Strip */
.courier-tracking-strip {
  margin-top: 12px;
  background: #F0FDF4;
  border: 1px solid #BBF7D0;
  border-radius: 10px;
  padding: 8px 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.courier-strip-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1;
}

.strip-icon {
  font-size: 16px;
  flex-shrink: 0;
}

.strip-text-col {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.strip-courier-name {
  font-size: 11px;
  font-weight: 700;
  color: #166534;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.strip-resi-txt {
  font-size: 10px;
  color: #15803D;
}

.resi-bold {
  font-family: monospace, sans-serif;
  font-weight: 700;
  color: #14532D;
}

.track-badge-btn {
  background: #16A34A;
  color: #FFFFFF;
  font-size: 9px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 6px;
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════════ */
/* EVENT CARD SPECIFICS                            */
/* ═══════════════════════════════════════════════ */
.card-main-row {
  display: flex;
  gap: 12px;
  align-items: center;
}

.card-thumb-wrapper {
  width: 46px;
  height: 46px;
  border-radius: 10px;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-icon-emoji {
  font-size: 22px;
}

.card-info-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.event-title {
  font-size: 13px;
  font-weight: 700;
  color: #0F172A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.meta-icon-text {
  font-size: 10px;
}

.meta-text {
  font-size: 11px;
  color: #64748B;
}

.ticket-badge {
  display: inline-block;
  background: #EFF6FF;
  border-radius: 4px;
  padding: 1px 6px;
  margin-top: 2px;
  width: fit-content;
}

.ticket-badge-text {
  font-size: 9px;
  color: #1D4ED8;
  font-weight: 600;
}

.chevron-arrow {
  font-size: 18px;
  color: #CBD5E1;
}

/* Divider & Footer */
.card-divider {
  height: 1px;
  background-color: #F1F5F9;
  margin: 12px 0;
}

.card-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.footer-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.total-label-txt {
  font-size: 10px;
  color: #64748B;
}

.amount-text {
  font-size: 14px;
  font-weight: 800;
  color: #F15A22;
}

.footer-actions-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-pay-action {
  background: #F15A22;
  border-radius: 8px;
  padding: 6px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(241, 90, 34, 0.25);
  cursor: pointer;
}

.btn-pay-action-txt {
  font-size: 11px;
  font-weight: 700;
  color: #FFFFFF !important;
  display: block;
}

.action-cta-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  background: #FFF7ED;
  border: 1px solid #FFEDD5;
  padding: 6px 10px;
  border-radius: 8px;
  cursor: pointer;
}

.cta-btn-txt {
  font-size: 11px;
  font-weight: 700;
  color: #EA580C;
}

.cta-arrow-icon {
  font-size: 14px;
  color: #EA580C;
  font-weight: 700;
  line-height: 1;
}

/* Status Pills */
.status-pill {
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  flex-shrink: 0;
}

.status-success, .status-completed, .status-delivered {
  background: #DCFCE7;
  color: #15803D;
}

.status-paid, .status-accepted, .status-processing {
  background: #E0F2FE;
  color: #0369A1;
}

.status-shipped {
  background: #EDE9FE;
  color: #6D28D9;
}

.status-pending {
  background: #FEF3C7;
  color: #B45309;
}

.status-cancelled, .status-failed, .status-rejected {
  background: #FEE2E2;
  color: #B91C1C;
}

.status-returned {
  background: #FCE7F3;
  color: #BE185D;
}

/* Empty State */
.empty-state-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 40px;
  margin-bottom: 10px;
}

.empty-title {
  font-size: 16px;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 4px;
}

.empty-desc {
  font-size: 12px;
  color: #64748B;
  margin-bottom: 16px;
  max-width: 240px;
}

.shop-now {
  background: #F15A22;
  color: #FFFFFF;
  font-size: 13px;
  font-weight: 700;
  padding: 8px 24px;
  border-radius: 10px;
  border: none;
  cursor: pointer;
}

/* ═══════════════════════════════════════════════ */
/* SHIMMER LOADING SKELETON                        */
/* ═══════════════════════════════════════════════ */
.shimmer-history-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.shimmer-history-card {
  height: 140px;
  border-radius: 16px;
  border: 1px solid #E2E8F0;
}

.skeleton {
  background: linear-gradient(
    90deg,
    #F1F5F9 25%,
    #E2E8F0 50%,
    #F1F5F9 75%
  );
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

