<view class="sticky-top">
  <top-bar
    type="{{'navigation'}}"
    navigate={{true}}
    backgroundColor="bg-white"
    color="black"
    title="{{'Pilih Tiket'}}"
    iconL="../../../../assets/icons/ic_common_arrow_back.svg"
    safeArea
    pixel
  />
</view>

<view class="index">
  <running-detail-one
    a:if="{{templateId == 1 }}" 
    ticket="{{ ticketData }}"
    runningData="{{ runningData }}"
    onBack="onBackToIndex"
    onBook="handleBooking"
    />
  <running-detail-two
    a:if="{{templateId == 2 }}" 
    ticket="{{ ticketData }}"
    runningData="{{ runningData }}"
    onBack="onBackToIndex"
    onBook="handleBooking"
    />
  <running-detail-three
    a:if="{{templateId == 3 }}" 
    ticket="{{ ticketData }}"
    runningData="{{ runningData }}"
    onBack="onBackToIndex"
    onBook="handleBooking"
    />
  <running-detail-four
    a:if="{{templateId == 4 }}" 
    ticket="{{ ticketData }}"
    runningData="{{ runningData }}"
    onBack="onBackToIndex"
    onBook="handleBooking"
    />
  <running-detail-custom
    a:if="{{templateId != 1 && templateId != 2 && templateId != 3 && templateId != 4 }}" 
    ticket="{{ ticketData }}"
    runningData="{{ runningData }}"
    templateId="{{ rawTemplateId }}"
    onBack="onBackToIndex"
    onBook="handleBooking"
    />
  <loading pixel loading="{{ isLoading }}"></loading>
</view>