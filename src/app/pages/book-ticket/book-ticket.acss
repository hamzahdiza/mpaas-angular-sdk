/* ═════════════════════════════════════════════════════════════════ */
/* STICKY BOTTOM CONTAINER & CTA BUTTONS                             */
/* ═════════════════════════════════════════════════════════════════ */

.bottom-container {
  background-color: #FFFFFF;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px 20px 24px;
  box-shadow: 0 -3px 10px 0 rgba(78, 78, 78, 0.12);
  border-top: 1px solid #ECECEC;
  z-index: 1000;
}

.bottom-summary-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.total-label-txt {
  font-size: 14px;
  color: #7A7A7A;
}

.total-price-txt {
  font-size: 18px;
  font-weight: 700;
  color: #0E0E0E;
}

.bottom-cta-btn {
  height: 56px;
  width: 100%;
  border-radius: 9999px;
  font-size: 16px;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.cta-maroon {
  background-color: #9C0621 !important;
  color: #FFFFFF !important;
}

.cta-navy {
  background-color: #0E3453 !important;
  color: #FFFFFF !important;
}

.cta-orange {
  background: linear-gradient(to right, #F97316, #F59E0B) !important;
  color: #FFFFFF !important;
  border-radius: 12px !important;
  height: 50px !important;
  text-transform: uppercase;
}

.cta-teal {
  background-color: #75D7D0 !important;
  color: #0E0E0E !important;
}

.btn-disabled {
  background-color: #E5E5E5 !important;
  color: #ABABAB !important;
  cursor: not-allowed;
}

/* Toast */
.toast-position {
  position: absolute;
  top: 60px;
  left: 16px;
  right: 16px;
  z-index: 100;
}