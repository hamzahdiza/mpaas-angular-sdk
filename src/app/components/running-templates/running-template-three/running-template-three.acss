.page-container {
  background: #f8fafc;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* HERO */
.hero-banner {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: #0f172a;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.event-badge {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  background: #f97316;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* EVENT CARD */
.event-card {
  margin: -120rpx 24rpx 0;
  position: relative;
  z-index: 10;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f1f5f9;
}

.event-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #0f172a;
  line-height: 52rpx;
  text-transform: uppercase;
  letter-spacing: -0.5rpx;
}


.event-summary {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e2e8f0;
  display: flex;
  justify-content: space-between;
}

.label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: bold;
}

.price {
  font-size: 38rpx;
  color: #ea580c;
  font-weight: bold;
  margin-top: 8rpx;
}

.date {
  font-size: 24rpx;
  color: #334155;
  font-weight: bold;
  margin-top: 8rpx;
}

.align-right {
  text-align: right;
}

/* SECTION */
.section-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
}

.border-top {
  border-top: 1rpx solid #f1f5f9;
  padding-top: 20rpx;
}

.icon-box {
  width: 64rpx;
  height: 64rpx;
  background: #fff7ed;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.info-value {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: bold;
  margin-top: 6rpx;
}

.info-address {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.link {
  color: #2563eb;
  font-size: 22rpx;
  margin-top: 10rpx;
}

/* DESCRIPTION */
.description {
  font-size: 24rpx;
  line-height: 38rpx;
  color: #475569;
}

/* CATEGORY */
.category-section {
  margin: 24rpx;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-card {
  background: #ffffff;
  border-left: 8rpx solid #f97316;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-content {
  flex: 1;
}

.category-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #0f172a;
}

.category-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.category-price-wrapper {
  text-align: right;
}

.category-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #0f172a;
}

.available-badge {
  margin-top: 8rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  display: inline-block;
}

.empty-card {
  background: #ffffff;
  padding: 40rpx;
  border-radius: 20rpx;
  text-align: center;
  color: #64748b;
}

/* SOCIAL */
.social-section {
  padding: 40rpx 24rpx;
  text-align: center;
}

.social-list {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.social-item {
  font-size: 24rpx;
  color: #64748b;
  font-weight: bold;
}

.powered-by {
  margin-top: 24rpx;
  font-size: 18rpx;
  color: #94a3b8;
}

/* BOTTOM BAR */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  padding: 44rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.bottom-price {
  font-size: 34rpx;
  font-weight: bold;
  color: #0f172a;
  margin-top: 6rpx;
}

.register-btn {
  background: #f97316;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 20rpx;
  padding: 0 40rpx;
  height: 84rpx;
  line-height: 84rpx;
}