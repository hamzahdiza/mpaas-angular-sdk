.container-running {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 120px;
}

/* HERO */

.hero-banner {
  width: 100%;
  height: 230px;
  overflow: hidden;
  background: #000000;
}

.hero-image {
  width: 100%;
  height: 100%;
}

/* FLOATING CARD */

.floating-container {
  margin-top: -32px;
  padding: 0 16px;
  position: relative;
  z-index: 10;
}

.event-card {
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0px 4px 10px rgba(78, 78, 78, 0.15);
}

.title-card {
  padding: 18px 20px;
  background: #0E3453;
  border-radius: 16px 16px 0 0;
}

.title-text {
  color: white;
  font-size: 18px;
  font-weight: 700;
  line-height: 130%;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16px 20px;
}

.info-icon {
  width: 24px;
  height: 24px;
}

.info-content {
  flex: 1;
  margin-left: 12px;
}

.txt-blue {
  color: #0E3453;
  font-size: 16px;
  font-weight: 600;
}

.txt-gray {
  color: #4E4E4E;
  font-size: 13px;
  margin-top: 2px;
}

.divider {
  height: 1px;
  background: #ECECEC;
  margin: 0 16px;
}

/* ACCORDION */

.accordion-card {
  background: white;
  margin: 14px 16px 0 16px;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0px 2px 8px rgba(78, 78, 78, 0.08);
}

.accordion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #0E3453;
}

.accordion-title {
  color: white;
  font-size: 16px;
  font-weight: 700;
}

.arrow {
  width: 20px;
  height: 20px;
}

.rotate {
  transform: rotate(180deg);
}

.accordion-body {
  padding: 16px 20px;
  color: #4E4E4E;
  line-height: 24px;
  font-size: 12px;
}

.line-clamp-4 {
  overflow: hidden;
  text-overflow: ellipsis;
}

.read-more {
  margin-top: 16px;
  text-align: center;
  color: #FF8736;
  font-weight: 700;
}

/* CTA */

.cta-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16px 24px 32px;
  background: white;
  box-shadow: 0px -3px 10px rgba(78, 78, 78, 0.15);
  z-index: 100;
}

.btn-buy {
  height: 56px;
  line-height: 56px;
  border-radius: 999px;
  background: #FF8736;
  color: white;
  font-size: 16px;
  font-weight: 700;
  border: none;
}