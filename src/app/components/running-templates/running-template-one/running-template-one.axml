
<view class="container-running">
  <view class="image-banner">
    <image mode="scaleToFill" src="{{data.bannerUrl}}" style="width:100%;height:100%; border-radius: 16px; " />
  </view>
  <view class="content-name txt-h3-px mg-b-8-px">
    {{data.name}}
  </view>

  <!-- <view class="content-chip">
    <view class="chip">
      Music
    </view>
    <view class="chip">
      Entertainment
    </view>
  </view> -->
  <view class="card-container"  >
    <view class="card-first">
      <view>
        <image  src="/src/assets/icons/ic_common_location.svg" style="width: 14px;
        height: 20px;"/>
      </view>
      <view style="display:felx;flex:direction-column;width:100%">
        <view class="txt-body1-sb-px">
          {{data.location}}
        </view>
        <view class="txt-body3-sb-px">
          {{data.locationAddress}}
        </view>
      </view>
      <image class="t5-icon-white" src="/src/assets/icons/ic_common_chevron_right.svg" style="width: 40px;
      height: 40px;"/>
    </view>
    <view class="divider" />

    <view class="card-first">
      <view>
        <image mode="scaleToFill" src="/src/assets/icons/ic_common_calendar_today.svg" style="width: 14px;
        height: 20px;"/>
      </view>
      <view style="display:felx;flex:direction-column;width:100%;margin-right:8px">
        <view class="txt-body1-sb-px">
          {{data.formattedDate}}
        </view>
        <view class="txt-body3-px">
          Simpan di kalender
        </view>
      </view>
      <image class="" src="/src/assets/icons/ic_common_chevron_right.svg" style="width: 40px;
      height: 40px;"/>
    </view>
  </view>
 

  <view class="txt-h4-px">
    Description
  </view>

  <view class="content-desc" style="padding:12px">
    <view>
     {{data.description}}
    </view>
  </view>

  <view class="txt-h4-px">
    Terms & Conditiond
  </view>

  <view class="content-desc" style="padding:12px">
    <view>
      <mp-html id="javajazz-festival-tnc-screen-webview" content="{{data.termsAndConditions}}" />
     
    </view>
  </view>

  <!-- <view class="txt-orange-300 underline" style="display:flex; align-items:center; justify-content:center; font-weight:bold;"> 
    <view>
      Lihat Detail v
    </view>
  </view> -->


</view>

<view class="cta-container">
  
  <!-- <view class="d-f-row jc-between mg-b-32">
    <text class="txt-body3-px">{{lang.javaJazzFestivalListInputDataVisitorScreenAmountLabel}}</text>
    <text class="txt-body2-sb-px" id="java-jazz-festival-list-input-data-screen-ticket-count">{{ticketCount + " " + Total}}</text>
  </view> -->
  <view>
    <bni-button
      type="primary"
      pixel
      onTap="handleRoomTap"
      className="{{  'bg-turquoise-300 txt-label1-sb-px' }}"
    >
      {{'Beli Tiket'}}
    </bni-button>
  </view>
</view>