/* ===================================================
   PAGE
=================================================== */

.container-detail {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 180rpx;
}

/* ===================================================
   HEADER
=================================================== */

.header-banner {
  height: 240rpx;
  background: linear-gradient(
    135deg,
    #9c0621 0%,
    #7a0419 100%
  );
}

.header-content {
  padding: 40rpx 32rpx;
}

.header-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  line-height: 52rpx;
}

/* ===================================================
   BANNER
=================================================== */

.banner-wrapper {
  padding: 0 24rpx;
  margin-top: -96rpx;
  position: relative;
  z-index: 10;
}

.banner-card {
  height: 380rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #f5f5f5;

  box-shadow:
    0 16rpx 36rpx rgba(156, 6, 33, 0.18);
}


.banner-image {
  width: 100%;
  height: 100%;
}

/* ===================================================
   CONTENT
=================================================== */

.content-wrapper {
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #111827;
  margin-bottom: 20rpx;
}

/* ===================================================
   EVENT INFORMATION
=================================================== */

.info-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 12rpx 0;

  box-shadow:
    0 8rpx 24rpx rgba(15,23,42,.06);

  margin-bottom: 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.info-icon {
  width: 72rpx;
  height: 72rpx;

  border-radius: 20rpx;

  display: flex;
  justify-content: center;
  align-items: center;
}

.info-icon image {
  width: 40rpx;
  height: 40rpx;
}

.info-content {
  flex: 1;
  margin-left: 20rpx;
}

.info-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #111827;
}

.info-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 34rpx;
}

/* ===================================================
   SECTION BLOCK
=================================================== */

.section-block {
  margin-bottom: 40rpx;
}

/* ===================================================
   DESCRIPTION
=================================================== */

.description-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;

  box-shadow:
    0 8rpx 24rpx rgba(15,23,42,.05);
}

.description-text {
  color: #475569;
  font-size: 24rpx;
  line-height: 40rpx;
}

.line-clamp-4 {
  overflow: hidden;
  max-height: 160rpx;
}

.read-more {
  margin-top: 24rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #ff8736;
  font-size: 24rpx;
  font-weight: bold;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

/* ===================================================
   TERMS
=================================================== */

.tnc-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;

  box-shadow:
    0 8rpx 24rpx rgba(15,23,42,.05);

  font-size: 24rpx;
  color: #475569;
  line-height: 40rpx;
  word-break: break-word;
}

/* ===================================================
   FLOATING MENU
=================================================== */

.floating-menu {
  position: fixed;

  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;

  height: 96rpx;

  background: #9c0621;

  border-radius: 999rpx;

  display: flex;
  align-items: center;

  padding: 0 12rpx;

  box-sizing: border-box;

  box-shadow:
    0 12rpx 32rpx rgba(156,6,33,.35);

  z-index: 999;
}

/* ===================================================
   FLOATING ICON
=================================================== */

.floating-icon {
  width: 72rpx;
  height: 72rpx;

  border-radius: 50%;

  display: flex;
  justify-content: center;
  align-items: center;
}

.floating-icon-img {
  width: 36rpx;
  height: 36rpx;
}

/* ===================================================
   BUY TICKET BUTTON
=================================================== */

.btn-ticket {
  margin-left: auto;

  height: 72rpx;
  padding: 0 40rpx;

  background: #ffffff;
  color: #9c0621;

  border-radius: 999rpx;

  display: flex;
  justify-content: center;
  align-items: center;

  font-size: 28rpx;
  font-weight: bold;

  box-shadow:
    0 6rpx 18rpx rgba(0,0,0,.12);
}


.bottom-price {
  font-size: 34rpx;
  font-weight: bold;
  color: white;
  margin-top: 6rpx;
}


.label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: bold;
}