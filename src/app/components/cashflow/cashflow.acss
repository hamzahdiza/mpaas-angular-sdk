.container {
  display: flex;
  position: relative;
  align-items: center;
  height: 100%;
  flex-direction: column;
  padding: 0px 24px;
}

.main-title {
  font-size: 24px;
  /* line-height: 28.8px; */
  font-weight: 700;
  margin-top: 40px
}

.main-desc {
  font-size: 16px;
  line-height: 22.4px;
  font-weight: 400;
}

.background-cashflow {
  position: absolute;
  bottom: 0;
  left: -3%;
  width: 100vw;
  z-index: -1;
}

.bar-section {
  position: relative;
  width: calc(327px - 32px);
  height: calc(241px - 48px);
  stroke-width: 1px;
  stroke: var(--functional-bw-tones-snow-white, #F0F0F0);
  filter: drop-shadow(0 5px 6px rgba(78, 78, 78, 0.15));
  padding: 24px 16px;
  display: grid;
  justify-content: center;
  display: grid;
  /* row-gap: 24px; */
  border-radius: 6%;
}

.label-container {
  margin-top: 10px !important;
}

.legend-container {
  width: 295px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 12px;
}

.legend-content {
  align-self: stretch;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 8px;
}

.legend-item {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
}

.item-label-wrap {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 4px;
}

.item-color-indicator {
  width: 8px;
  height: 8px;
  border-radius: 2px;
}

.green-bg {
  background: #02C794;
}

.red-bg {
  background: #D65C5C;
}

.item-label-text {
  font-size: 12px;
  line-height: 16.8px;
  font-weight: 400;
}

.item-value-text {
  font-size: 14px;
  font-style: normal;
  font-weight: 600;
  line-height: 140%;
}

.vertical-divider {
  width: 1px;
  height: 24px;
  background-color: #C6C6C6;
}

.bar-chart-item {
  margin-top: 24px;
  height: 132px;
  display: flex;
  padding: 0 24px;
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
}

.bg-cashflow {
  position: absolute;
  width: 105%;
  height: 109%;
  top: -5px;
  left: -8px;
  z-index: -1;
}

.tape-1 {
  position: absolute;
  /* width: 90.874px;
  height: 81.633px; */
  width: 131px;
  height: 121px;
  transform: rotate(0deg);
  z-index: 3;
  top: -48px;
  left: -57px;
}

.tape-2 {
  position: absolute;
  width: 131px;
  height: 121px;
  transform: rotate(0deg);
  z-index: 3;
  bottom: -51px;
  right: -52px
}

.cta {
  display: flex;
  width: 48px;
  height: 48px;
  justify-content: center;
  align-items: center;
  border-radius: 32px;
  border: 1px solid #FFF;
  background: rgba(14, 14, 14, 0.10);
  backdrop-filter: blur(5px);
}

.cta-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 0 24px;
  position: absolute;
  bottom: 40px;
}

.icon-style {
  width: 24px;
  height: 24px;
}

@media (max-width: 380px) and (max-height: 700px) {
  .container {
    display: flex;
    position: relative;
    align-items: center;
    height: 100%;
    flex-direction: column;
    padding: 0rpx 48rpx;
  }

  .main-title {
    font-size: 16px;
    /* line-height: 19.2px; */
    font-weight: 700;
    margin-top: 40px
  }

  .main-desc {
    font-size: 12px;
    line-height: 16.8px;
    font-weight: 400;
  }

  .background-cashflow {
    position: absolute;
    bottom: 0;
    left: -3%;
    width: 100vw;
    z-index: -1;
  }

  .bar-section {
    position: relative;
    width: calc(654rpx - 64rpx);
    height: calc(482rpx - 96rpx);

    stroke-width: 2rpx;
    stroke: var(--functional-bw-tones-snow-white, #F0F0F0);
    filter: drop-shadow(0 0 12rpx rgba(78, 78, 78, 0.15));
    padding: 48rpx 32rpx;
    display: grid;
    justify-content: center;
  }

  .label-container {
    margin-top: 20rpx !important;
  }

  .legend-container {
    width: 590rpx;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 24rpx;
  }

  .legend-content {
    align-self: stretch;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 16rpx;
  }

  .legend-item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
  }

  .item-label-wrap {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 8rpx;
  }

  .item-color-indicator {
    width: 16rpx;
    height: 16rpx;
    border-radius: 4rpx;
  }

  .item-label-text {
    font-size: 24rpx;
    line-height: 33.6rpx;
    font-weight: 400;
  }

  .item-value-text {
    font-size: 28rpx;
    font-style: normal;
    font-weight: 600;
    line-height: 140%;
  }

  .vertical-divider {
    width: 2rpx;
    height: 48rpx;
    background-color: #C6C6C6;
  }

  .bar-chart-item {
    margin-top: 48rpx;
    height: 264rpx;
    display: flex;
    padding: 0 48rpx;
    justify-content: center;
    align-items: flex-start;
    align-self: stretch;
  }

  .bg-cashflow {
    position: absolute;
    width: 105%;
    height: 109%;
    top: -10rpx;
    left: -16rpx;
    z-index: -1;
  }

  .tape-1 {
    position: absolute;
    width: 131px;
    height: 121px;
    transform: rotate(0deg);
    z-index: 3;
    top: -110rpx;
    left: -95rpx
  }

  .tape-2 {
    position: absolute;
    width: 131px;
    height: 121px;
    transform: rotate(0deg);
    z-index: 3;
    bottom: -134rpx;
    right: -104rpx
  }

  .cta {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    justify-content: center;
    align-items: center;
    border-radius: 64rpx;
    border: 2rpx solid #FFF;
    background: rgba(14, 14, 14, 0.10);
    backdrop-filter: blur(5px);
  }

  .cta-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: 0 48rpx;
    position: absolute;
    bottom: 80rpx;
  }

  .icon-style {
    width: 48rpx;
    height: 48rpx;
  }
}

@media (min-width: 750px) {
  .container {
    background-color: transparent;
    display: flex;
    position: relative;
    align-items: center;
    height: 100%;
    flex-direction: column;
    padding: 0px 24px;
  }

  .main-title {
    font-size: 24px;
    /* line-height: 28.8px; */
    font-weight: 700;
    margin-top: 40px
  }

  .main-desc {
    font-size: 16px;
    line-height: 22.4px;
    font-weight: 400;
  }

  .background-cashflow {
    position: absolute;
    bottom: -16%;
    left: -3%;
    width: 100%;
    height: 526px;
    z-index: -1;
  }

  /* --- Bagian Utama --- */
  .bar-section {
    position: relative;
    /* Kunci tinggi sesuai permintaan Anda */
    height: calc(241px - 20px) !important;
    /* Lebar dibuat responsif dengan rpx agar tidak pecah di HP kecil */
    width: 654rpx;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    /* Memberi ruang proporsional antara legend dan chart */

    padding: 24px 16px;
    box-sizing: border-box;
    /* Memastikan padding tidak menambah tinggi total */
    filter: drop-shadow(0 5px 6px rgba(78, 78, 78, 0.15));
    margin: 0 auto;
  }

  .bg-cashflow {
    position: absolute;
    top: 0;
    left: -5%;
    width: 110%;
    height: 241px !important;
    /* Akan otomatis menjadi 241px mengikuti induknya */
    z-index: -1;
    /* Menggunakan mode ini agar SVG tetap tajam */
    object-fit: stretch;
  }

  /* --- Penyesuaian Elemen Dalam agar pas dengan 241px --- */
  .legend-container {
    width: 295px;
    z-index: 2;
  }

  .bar-chart-item {
    width: calc(100% - 48px);
    height: 120px;
    /* Tinggi chart disesuaikan agar tidak overflow dari 241px */
    margin-top: -40px;
    display: flex;
    justify-content: center;
    z-index: 2;
  }

  .legend-content {
    align-self: stretch;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 8px;
  }

  .bar-label {
    color: var(--functional-bw-tones-black, #0E0E0E) !important;
    text-align: center !important;
    leading-trim: both !important;
    text-edge: cap;
    font-feature-settings: 'liga'off, 'clig'off !important;

    /* Mobile/Label/Label 2 - Regular */
    font-family: "TT Interphases Pro" !important;
    font-size: 12px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 120% !important;
    /* 14.4px */
  }

  .label-container-text {
    font-size: 12px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 120% !important;
  }

  .tape-1 {
    position: absolute;
    width: 131px;
    height: 121px;
    transform: rotate(0deg);
    z-index: 3;
    top: -56rpx;
    left: -70rpx
  }

  .tape-2 {
    position: absolute;
    width: 131px;
    height: 121px;
    transform: rotate(0deg);
    z-index: 3;
    bottom: -56rpx;
    right: -70rpx
  }

}

.item-label-wrap {
  gap: 0px;
}


.item-label-text {
  margin-left: 4px;
}