.pie-chart-canvas {
  width: 650rpx;
  height: 550rpx;
}
.pie-chart-mask {
  position: absolute;
  bottom: 0;
  z-index: 2;
  width: 100%;
  height: 500rpx;
  background-color: #ffffff;
}
.pie-chart-animation {
  position: absolute;
  bottom: 0;
  z-index: 2;
  width: 100%;
  height: 500rpx;
  animation: pieChartAnimation .4s .1s 1 linear both;
  pointer-events: none;
}

@keyframes pieChartAnimation {
  0% {
    background: conic-gradient(transparent 0% , #ffffff 0%);
  }
  5% {
    background: conic-gradient(transparent 5% , #ffffff 5%);
  }
  10% {
    background: conic-gradient(transparent 10% , #ffffff 10%);
  }
  15% {
    background: conic-gradient(transparent 15% , #ffffff 15%);
  }
  20% {
    background: conic-gradient(transparent 20% , #ffffff 20%);
  }
  25% {
    background: conic-gradient(transparent 25% , #ffffff 25%);
  }
  30% {
    background: conic-gradient(transparent 30% , #ffffff 30%);
  }
  35% {
    background: conic-gradient(transparent 35% , #ffffff 35%);
  }
  40% {
    background: conic-gradient(transparent 40% , #ffffff 40%);
  }
  45% {
    background: conic-gradient(transparent 45% , #ffffff 45%);
  }
  50% {
    background: conic-gradient(transparent 50% , #ffffff 50%);
  }
  55% {
    background: conic-gradient(transparent 55% , #ffffff 55%);
  }
  60% {
    background: conic-gradient(transparent 60% , #ffffff 60%);
  }
  65% {
    background: conic-gradient(transparent 65% , #ffffff 65%);
  }
  70% {
    background: conic-gradient(transparent 70% , #ffffff 70%);
  }
  75% {
    background: conic-gradient(transparent 75% , #ffffff 75%);
  }
  80% {
    background: conic-gradient(transparent 80% , #ffffff 8%);
  }
  85% {
    background: conic-gradient(transparent 85% , #ffffff 85%);
  }
  90% {
    background: conic-gradient(transparent 90% , #ffffff 90%);
  }
  95% {
    background: conic-gradient(transparent 95% , #ffffff 95%);
  }
  100% {
    background: unset;
  }
}