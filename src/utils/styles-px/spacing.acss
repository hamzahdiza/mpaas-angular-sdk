/* This CSS styling converts dimensions from rpx (responsive pixel) to px (pixels) using a 2x ratio 
* Note: This conversion applies to styles originally created by ANT to accomodate Wealth Management Project conversion to px.
*/


/*padding*/
.pd-v-0 {
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

.pd-v-4 {
  padding-top: 2px;
  padding-bottom: 2px;
}

.pd-v-8 {
  padding-top: 4px;
  padding-bottom: 4px;
}

.pd-v-16 {
  padding-top: 8px;
  padding-bottom: 8px;
}

.pd-v-24 {
  padding-top: 12px;
  padding-bottom: 12px;
}

.pd-v-32 {
  padding-top: 16px;
  padding-bottom: 16px;
}

.pd-v-48 {
  padding-top: 24px;
  padding-bottom: 24px;
}

