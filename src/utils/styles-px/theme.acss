/* This CSS styling converts dimensions from rpx (responsive pixel) to px (pixels) using a 2x ratio 
* Note: This conversion applies to styles originally created by ANT to accomodate Wealth Management Project conversion to px.
*/

:root {
  --orange-100: #ffdbc3;
  --orange-200: #ffa76b;
  --orange-300: #ff8736;
  --orange-400: #fa6805;
  --orange-500: #d15502;
  --turquoise-100: #c2f0ec;
  --turquoise-100-20: #C2F0EC33;
  --turquoise-200: #99e5df;
  --turquoise-300: #71dbd3;
  --turquoise-400: #3aa8a0;
  --turquoise-500: #017a71;
  --purple-100: #dacff2;
  --purple-200: #bba7e7;
  --purple-300: #9b7edc;
  --purple-400: #6a4ab2;
  --purple-500: #3b1297;
  --yellow-100: #ffe299;
  --yellow-200: #ffd366;
  --yellow-300: #ffc533;
  --yellow-400: #e3a200;
  --yellow-500: #b17f00;
  --lime-100: #e7f57a;
  --lime-200: #deef5a;
  --lime-300: #d0e054;
  --lime-400: #9ca83f;
  --lime-500: #68702a;
  --light-gray: #c6c6c6;
  --gray: #a0a0a0;
  --granite: #7a7a7a;
  --charcoal: #4e4e4e;
  --black: #0e0e0e;
  --white: #ffffff;
  --off-white: #f9f9f9;
  --snow-white: #f0f0f0;
  --pale-gray: #dadada;
  --magenta-100: #fedbff;
  --magenta-200: #fda9ff;
  --magenta-300: #fc75ff;
  --magenta-400: #e30ce8;
  --magenta-500: #b800bd;
  --emerald-100: #c8f4cd;
  --emerald-200: #9deca6;
  --emerald-300: #7be587;
  --emerald-400: #42b346;
  --emerald-500: #1f7a22;
  --blue-100: #bdcfff;
  --blue-100-30 : #BDCFFF4D;
  --blue-200: #99b5ff;
  --blue-300: #5f84e8;
  --blue-400: #2e5fe0;
  --blue-500: #1a44b2;
  --success: #02c794;
  --error: #d65c5c;
  --warning: #ebbc44;
  --info: #21797e;
  --success-off: #e1fef7;
  --error-off: #ffeaea;
  --warning-off: #fff5db;
  --info-off: #eaf1f1;
}

