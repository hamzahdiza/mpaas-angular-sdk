<view class="container">
  <view class="left-card-section regular-card">
    <view class="title-left-section">
      <text
        id="portfolio-detail-rsp-reccuring-date"
        class="break-text"
      >
        {{langRecDate}}
      </text>
    </view>

    <view
      id="portfolio-detail-rsp-reccuring-date-value"
      class="renewal-date-info"
    >
      {{reccuringDate}}
    </view>
  </view>

  <view class="right-card-section regular-card">
    <view class="right-info">         
      <view class="container-funds-info">      
        <view
          id="portfolio-detail-rsp-amount"
          class="total-funds-info"
        >
          {{amount}}
        </view>
        
        <view
          id="portfolio-detail-rsp-end-date"
          class="due-date-info"
        >
          {{langEndDate.split('__endDate__')[0]}} {{endDate}}
        </view>
      </view>

      <view>
        <image
          id="portfolio-detail-rsp-chevron"
          mode="scaleToFill"
          src="/assets/icons/ic_common_chevron_right.svg"
          class="w-32 h-32"
        />
      </view>
    </view>
  </view>
</view>