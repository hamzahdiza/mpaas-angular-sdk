.bottom-filter {
  background-color: white;
  position: fixed;
  width: 100%;
  height: 0px;
  bottom: 0;
  box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
  transition: height 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  padding-left: 24px;
  padding-right: 24px;
  box-sizing: border-box;
  z-index: 5;
  /* transition: height 0.3s ease-in-out; */
}

.bottom-filter.half-open {
  height: 121px;
  opacity: 1;
}

.bottom-filter.expanded {
  height: 254px;
  opacity: 1;
}

.handle {
  margin-top: 16px;
  display: flex;
  align-content: center;
  justify-content: center;
  height: 50px;
  z-index: 10;
}

.handle-bar {
  width: 36px;
  height: 5px;
  border-radius: 5px;
  background: var(--functional-bw-tones-light-gray, #C6C6C6);
}

.safe-area {
  height: 0;
}