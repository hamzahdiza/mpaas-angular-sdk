.main-container {
  width: 295px;
  height: 195px;
}

.bar-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-container {
  position: absolute;
  bottom: 100%;
  margin-bottom: 8px;
  z-index: 10;
  width: 132px;
  height: 54px;
  margin-bottom: 12px;
}

.popup-inner-container {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 8px 12px;
  box-shadow: 0px 5px 16px 0px rgba(78, 78, 78, 0.27);
  text-align: start;
}

.chart-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-bottom: 24px;
}

.chart-container-multiple {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  width: 100%;
  position: relative;
  border-bottom: solid 1px #DADADA;
  height: 100%;
}

.label-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  position: relative;
}

.label-container-text {
  height: 24px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bar {
  display: flex;
  height: 108px;
  padding: 0px 24px;
  justify-content: center;
  align-items: flex-end;
  align-self: stretch;
  border-bottom: solid 1px #DADADA;

}

.bar-multiple {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  height: 108px;
}

.bar-label {
  display: flex;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  text-align: center;
  flex-wrap: wrap;
}

.bar-label-wrapped {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  align-self: stretch;
  text-align: center;
  flex-wrap: wrap;
  max-width: 50px;
}

.bar-inner {
  width: 56px;
  border-radius: 8px 8px 0px 0px;
}

.bar-inner-multiple {
  border-radius: 8px 8px 0px 0px;
}

.bar-inner.pink {
  background-color: #FFEAEA;
}

.bar-inner.red {
  background-color: #D65C5C;
}

.bar-inner.turquoise {
  background-color: #C2F0EC;
}

.bar-inner.green {
  background-color: #02C794;
}

.pop-up-bar-chart {
  position: absolute;
  width: 30px;
  height: 30px;
  background-color: yellow;
  right: 0;
}