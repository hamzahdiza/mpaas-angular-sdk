<view class="content-failed d-f-column ai-center">
  <view class="container-ilustration">
    <view class="image-content-wealth mg-b-24">
      <view  class="image-wealth"/>
    </view>
  
    <view class="title-wealth txt-h3 mg-t-48">
      {{ title || lang.bondsPortfolioLandingScreenTitleErrorState }}
    </view>
  
    <view class="content-wealth txt-body2">
      {{ content || lang.bondsPortfolioLandingScreenSubTitleErrorState }}
    </view>
  </view>

  <view onTap="handleReload" class="mg-t-48 d-f-row ai-center jc-center pd-v-16 pd-h-32" id="handle-reload">
    <view class="mg-r-16 w-48 h-48 bni-button-icon" mode="scaleToFill" />
    <text class="txt-h5 txt-orange-300">
      {{lang.bondsPortfolioLandingScreenRefresh}}
    </text>
  </view>
</view>