@keyframes blink {
  50% {
    opacity: 0;
  }
}

@keyframes blink-border {
  50% {
    border-left-color: #fff;
  }

  100% {
    border-left-color: #0e0e0e;
  }
}

.amount-input-placeholder {
  color: #a0a0a0;
}

.outside_img {
  margin-left: auto;
}

.clear-icon-container {
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
}

.clear-icon-container-blink {
  animation: blink-border 1s infinite steps(1, start);
  border-left: solid 1.0px #0e0e0e;
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
}

.amount-input-container {
  border-bottom-style: solid;
  border-bottom-width: 1.0px;
  display: flex;
  flex-direction: row;
  width: calc(375.0px - 48.0px);
  background: #fff;
  font-size: 28.0px;
  font-style: normal;
  font-weight: 800;
  line-height: 120%;
}

.amount-input-pretext {
  justify-self: flex-start;
  margin-right: 8.0px;
  height: 34.0px;
  width: 35.0px;
}

.amount-input-focus2::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 1.0px;
  height: 33.5px;
  background-color: #0e0e0e;
  animation: blink-border 1s infinite steps(1, start);
  font-family: Montserrat;
  font-size: 32.0px;
  line-height: 40.0px;
}

.scrollView {
  display: flex;
}

.usd-input-width {
  box-sizing: border-box;
  display: flex;
  width: 234.0px;
}

.error-font {
  color: #d65c5c;
  font-size: 12.0px;
  line-height: 120%;
}

.disabled-font {
  color: #0E0E0E;
  font-size: 12.0px;
  line-height: 120%;
}

.amount-boder {
  border-radius: 8.0px;
  background: #fff;
}

.usd-input {
  padding: 16.0px 12.0px;
}

.usd-input-pretext {
  width: 80.0px;
  padding: 15.0px 0 15.0px 12.0px;
  flex-shrink: 0;
  border-right: 1.0px solid #c6c6c6;
}

.usd-input-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: calc(375.0px - 50.0px);
  background: #fff;
  font-size: 20.0px;
  font-weight: 800;
  line-height: 120%;
}

/* 
  keyboard
*/
.input-keyboard {
  width: 375.0px;
  z-index: 999;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  position: fixed;
  bottom: 0px;
  left: 0px;
}

.input-keyboard-selesai {
  display: flex;
  width: 375.0px;
  justify-content: flex-end;
  align-items: center;
  background: #f0f0f0;
  height: 34px;
}

.input-keyboard-selesai-text {
  display: flex;
  height: 18px;
  padding: 8px 16.0px;
  justify-content: center;
  align-items: center;
  color: #ff8736;
  text-align: center;
  font-size: 12.0px;
  font-weight: 700;
  line-height: 120%;
}

.input-box-icon {
  margin-left: 16.0px;
  height: 20.0px;
  width: 20.0px;
}

.input-box-icon:first-child {
  margin-left: 0.0px;
}

.input-keyboard-group {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 6px;
  padding-bottom: 57px;
  justify-content: center;
  align-items: center;
  background: #dadada;
}

.input-keyboard-group-row {
  display: flex;
  align-items: center;
  margin-top: 8px;
}

.input-keyboard-group-row:first-child {
  margin-top: 0.0px;
}

.input-keyboard-group-button {
  display: flex;
  height: 45px;
  width: 117.0px;
  border-radius: 4.0px !important;
  padding: 8px 8.0px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #0e0e0e;
  text-align: center;
  font-size: 24.0px;
  font-weight: 700;
  line-height: 120%;
  margin-left: 4.0px;
}

.input-keyboard-group-button:first-child {
  margin-left: 0.0px;
}

.input-keyboard-delete-button-box {
  display: flex;
  height: 45px;
  width: 117.0px;
  /* padding: 8px; */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #0e0e0e;
  text-align: center;
  margin-left: 4.0px;
}

.input-keyboard-group-delete-button {
  background: #dadada;
  border: 0px;
  display: flex;
  width: 32.0px;
  height: 32px;
  justify-content: center;
  align-items: center;
  color: #0e0e0e;
  text-align: center;
}

.input-amount-popup {
  height: 301px;
  position: fixed;
  bottom: 0;
}

.usd-input-cursor::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 1.0px;
  height: 24.0px;
  background-color: #0e0e0e;
  animation: blink 1s infinite steps(1, start);
  font-family: Montserrat;
  font-size: 32.0px;
  line-height: 40.0px;
}

.amount-input-position {
  text-align: end;
  position: relative;
}

.popover-content::after {
  content: "";
  transform: translate(-50%, 100%) rotate(180deg);
  left: 50%;
  bottom: 1px;
  position: absolute;
  width: 0;
  height: 0;
  border-bottom: 8.5px solid black;
  border-left: 8.5px solid transparent;
  border-right: 8.5px solid transparent;
  z-index: 1;
}

.popover {
  position: absolute;
  background: black;
  z-index: 9999;
  width: 100.0px;
  color: white;
  top: -50%;
  left: 50%;
  right: 50%;
  transform: translate(-50%, -50%);
  border-radius: 5.0px;
  padding: 5.0px;
}

.popover-content {
  display: flex;
  justify-content: space-around;
}
.input-keyboard-group-row-px {
  display: flex;
  align-items: center;
  margin-top: 8px
}
.button-done {
  width: calc(100vw - 48px);
  padding-top: 16px;
}