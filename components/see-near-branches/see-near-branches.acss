.show-near-error {
	height: 44.0px;
	padding: 6.0px 24.0px;
}
.nohaveSID-noportfolios-image {
	padding: 91.0px 0;
	width: 253.0px;
	height: 193.0px;
}
.nohaveSID-noportfolios-button {
	height: 85.0px;
	width: calc(100% - 24.0px * 2);
}

.default-btn {
  max-width: 327.0px;
  max-height: 48.0px;
  border: 1.0px solid #7a7a7a;
  font-size: 14.0px;
  font-weight: 600;
}

.primary-btn {
  max-width: 327.0px;
  max-height: 48.0px;
  border: none;
  font-size: 14.0px;
  font-weight: 600;
  line-height: 48.0px;
}

.see-branch .ant-popup-content {
	height: 100vh;
}

.see-branch .ant-popup-transform-bottom{
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
}

.w-253h-193{
  width: 253.0px;
  height: 193.0px;
