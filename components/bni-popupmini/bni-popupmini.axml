<block a:if="{{ pixel }}">
  <popup visible="{{basicVisible}}" position="bottom" onClose="handlePopupClose">
    <slot name="contentInside" />
  </popup>

</block>
<block a:if="{{ !pixel }}">
  <popup visible="{{basicVisible}}" position="bottom" onClose="handlePopupClose">
    <slot name="contentInside" />
  </popup>
</block>