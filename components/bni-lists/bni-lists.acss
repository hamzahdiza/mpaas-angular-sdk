.container-list-date {
  display: flex;
  width: 100%;
  flex-direction: column;
}

.date {
  display: flex;
  width: 100%;
  padding-top: 8px;
  flex-direction: column;
  align-items: flex-start;
}

.date text {
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Body/Body 2 - DemiBold */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 600;
  line-height: 140%;
  /* 19.6px */
}

.divider-date {
  display: flex;
  height: 1px;
  padding-top: 1px;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  width: 100%;
  height: 1px;
  background: #DADADA;
  margin: 8px 0px 16px 0px
}

.divider-custom-contacts {
  border-bottom: 1px solid #DADADA;
  padding-bottom: 8px;
}

.container-list-item {
  display: flex;
  width: 100%;
  align-items: center;
  padding-bottom: 16px;
}

.custom-contacts {
  padding-bottom: 0px;
  padding-top: 16px;
  padding-bottom: 16px;
}

.image-icon {
  display: flex;
  padding: 12px;
  /* width: 48px;
  height: 48px; */
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 60px;
  background: #e0dddd;
  margin-right: 12px
}

.image {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.container-detail-date {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  flex: 1 0 0;
}

.date-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4px;
  align-self: stretch;

}

.date-title text {
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Body/Body 2 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  /* 19.6px */
}

.container-metadata {
  display: flex;
  justify-content: space-between;
  gap: 4px;
  align-self: stretch;
}

.metadata-left {
  display: flex;
  align-items: flex-start;
  align-content: flex-start;
  gap: 0 4px;
  align-self: stretch;
  flex-wrap: wrap;
}

.metadata-left text {
  color: var(--functional-bw-tones-granite-gray, #7A7A7A);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Body/Body 3 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  /* 16.8px */
}

.metadata-right {
  display: flex;
  width: 104px;
  justify-content: flex-end;
  align-items: center;
  gap: 4px;
}

.metadata-right text {
  color: var(--functional-bw-tones-gray, #A0A0A0);
  text-align: right;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Body/Body 3 - DemiBold */
  font-family: "TT Interphases Pro";
  font-size: 12px;
  font-style: normal;
  font-weight: 600;
  line-height: 140%;
  /* 16.8px */
}


.image-icon-transactionHistory {
  display: flex;
  width: 48px;
  align-items: flex-start;
  flex-shrink: 0;
  margin-right: 12px;
}

.image-transactionHistoy {
  height: 48px;
  width: 48px;
}

.initial {
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border-radius: 60px;
  text-align: center;

  width: 48px;
  height: 48px;
  margin-right: 8px;
}

.account-number-container {
  display: flex;
  align-items: flex-start;
  align-content: flex-start;
  align-self: stretch;
  flex-wrap: wrap;

  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 4 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 16px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 19.2px */
}

.margin-4 {
  margin-left: 4px;
  margin-right: 4px;
}

.container-group {
  margin-top: 8px;
}

.letter {
  color: var(--functional-bw-tones-charcoal-gray, #4E4E4E);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Label/Label 1 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 120%;
  /* 16.8px */
}