

.container-chevron{
  position: fixed;
  top: 295px;
  width: 100%;
  z-index: 15;
}

.chevron-left{
  position: absolute;
  left: 0px;
  background-image: url('data:image/svg+xml,<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Icon L"><path id="Icon" d="M14.4025 18.0799L9.4725 13.1499C8.8425 12.5199 8.8425 11.4799 9.4725 10.8499L14.4025 5.91992L15.8125 7.32992L11.1425 11.9999L15.8125 16.6699L14.4025 18.0799Z" fill="%237A7A7A"/></g></svg>');
  background-repeat: no-repeat;
  background-position: center;
}

.chevron-right{
  position: absolute;
  right: 0px;
  background-image: url('data:image/svg+xml,<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Icon L"><path id="Icon" d="M10.15 18.0799L8.73999 16.6699L13.41 11.9999L8.73999 7.32992L10.15 5.91992L15.08 10.8499C15.71 11.4799 15.71 12.5199 15.08 13.1499L10.15 18.0799Z" fill="%237A7A7A"/></g></svg>');
  background-repeat: no-repeat;
  background-position: center;
}

.content-chevron-left{
  background-color: var(--off-white);
  width: 24px;
  height: 24px;
  padding: 8px;
  border-radius: 0 98px 98px 0;
}
.content-chevron-right{
  background-color: var(--off-white);
  width: 24px;
  height: 24px;
  padding: 8px;
  border-radius: 98px 0 0 98px;
}


.indicator {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  gap: 8px;
  margin: 16rpx 0;
}

.indicator>view {
  width: 100%;
  position: relative;
}


.indicator-bar {
  z-index: 1;
  width: 100%;
  height: 4px;
  border-radius: 4px;
}


.indicator-active {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  border-radius: 4px;
  z-index: 2
}

.indicator-load {
  animation-name: indicator-load;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
}


@keyframes indicator-load {
  0% {
    width: 0;
  }

  100% {
    width: 100%;
  }
}

.indicator-item-px {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.unactive-dots-px {
  width: 8px; 
  height: 8px; 
  margin-right: 4px; 
  mask-image: url('data:image/svg+xml,%3Csvg width%3D%229%22 height%3D%228%22 viewBox%3D%220 0 9 8%22 fill%3D%22none%22 xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg id%3D%22Component%20Breakdown_Carousel%22%3E%3Ccircle id%3D%22Shape%22 cx%3D%224.5%22 cy%3D%224%22 r%3D%224%22 fill%3D%22%23C6C6C6%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
  mask-position: center;
  mask-size: contain;
  mask-repeat: no-repeat;
  background-color: #C6C6C6; 
  transition: mask-image 1s ease;
}

.active-dots-px {
  width: 8px; 
  height: 8px; 
  margin-right: 4px; 
  mask-image: url('data:image/svg+xml,%3Csvg width%3D%229%22 height%3D%228%22 viewBox%3D%220 0 9 8%22 fill%3D%22none%22 xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg id%3D%22Component%20Breakdown_Carousel%22%3E%3Ccircle id%3D%22Shape%22 cx%3D%224.5%22 cy%3D%224%22 r%3D%224%22 fill%3D%22%230E0E0E%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
  mask-position: center;
  mask-size: contain;
  mask-repeat: no-repeat;
  background-color: #0E0E0E;
  transition: mask-image 1s ease;
}

