  border-style: solid;
}

.birthdate-section-input-px {
  padding: 6px 12px;
  height: calc(100% - 12px);
  display: flex;
  align-items: center;
}

.birthdate-input-px {
  width: 100%;
  padding: 0px;
  height: auto;
}

.birthdate-clear-icon-px {
  width: 24px;
  height: 24px;
}

.border-white {
  border: 1px solid var(--functional-bw-tones-white, #FFF);
}


.ant-number-keyboard-kb {
  border-top: 1px solid #f5f5f5;
}