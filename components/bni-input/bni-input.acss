.input {
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-width: 2rpx;
  border-style: solid;
}

.clear-input-icon-container {
  content: "";
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  width: 2rpx;
  height: 40rpx;
}

.clear-input-icon-container-blink {
  content: "";
  animation: blink-border 1s infinite steps(1, start);
  border-left: solid 2rpx #0e0e0e;
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  width: 2rpx;
  height: 40rpx;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}

@keyframes blink-border {
  50% {
    border-left-color: #fff;
  }

  100% {
    border-left-color: #0e0e0e;
  }
}

.usd-input-cursor::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 2rpx;
  height: 48rpx;
  background-color: #0e0e0e;
  animation: blink 1s infinite steps(1, start);
  font-family: Montserrat;
  font-size: 64rpx;
  line-height: 80rpx;
}


.popover-content::after {
  content: "";
  transform: translate(-50%, 100%) rotate(180deg);
  left: 50%;
  bottom: 1px;
  position: absolute;
  width: 0;
  height: 0;
  border-bottom: 8.5px solid black;
  border-left: 8.5px solid transparent;
  border-right: 8.5px solid transparent;
  z-index: 1;
}

.inputAmount {
  width: calc(750rpx - 96rpx);
  border-radius: 16rpx;
  padding: 24rpx 0rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-width: 2rpx;
  border-style: solid;
}

.inputAmountType {
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-width: 2rpx;
  border-style: solid;
}

.searchStyle {
  padding: 3rpx 32rpx;
}

.amount-center {
  /* width: calc(100% - 70rpx); */
  display: flex;
  flex-grow: 1;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.inputGroup {
  display: flex;
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.messageIconStyle {
  width: 32rpx;
  height: 32rpx;
  padding-right: 8rpx;
}

.message {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-top: 8rpx;
}

.message-amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 8rpx;
}

.suffixIconStyle {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
}

.prefixIconStyle {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.prefixIconTextProp {
  margin-right: 16rpx;
}

.suffixIconTextProp {
  margin-left: 16rpx;
}

.error {
  mask-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M7.99992 1.3335C4.33325 1.3335 1.33325 4.3335 1.33325 8.00016C1.33325 11.6668 4.33325 14.6668 7.99992 14.6668C11.6666 14.6668 14.6666 11.6668 14.6666 8.00016C14.6666 4.3335 11.6666 1.3335 7.99992 1.3335ZM7.99992 12.0002C7.59992 12.0002 7.33325 11.7335 7.33325 11.3335C7.33325 10.9335 7.59992 10.6668 7.99992 10.6668C8.39992 10.6668 8.66659 10.9335 8.66659 11.3335C8.66659 11.7335 8.39992 12.0002 7.99992 12.0002ZM8.66659 9.3335H7.99992H7.33325V4.00016H7.99992H8.66659V9.3335Z" fill="%23D65C5C"/></svg>');
