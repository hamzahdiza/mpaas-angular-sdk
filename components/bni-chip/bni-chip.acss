.filled-container-small {
  padding: 12rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}

.filled-container-medium {
  padding: 16rpx 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 32rpx;
}

.container-with-icon {
  padding: 8rpx 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 32rpx;
}

.icon-left {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.icon-right {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.chip-text-container {
  width: 150rpx;
  display: flex;
  justify-content: flex-end;
}

.text-small {
  line-height: 14rpx;
}

.text-medium {
  line-height: 16rpx;
}

/* PIXEL MODE */

.filled-container-small-px {
  padding: 6px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
}

.filled-container-medium-px {
  padding: 8px 13px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 16px;
}

.container-with-icon-px {
  padding: 4px 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 16px;
}

.icon-left-px {
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

.icon-right-px {
  width: 16px;
  height: 16px;
  margin-left: 4px;
}

.chip-text-container-px {
  width: 75px;
  display: flex;
  justify-content: flex-end;
}

.text-small-px {
  line-height: 7px;
}

.text-medium-px {
  line-height: 8px;
}