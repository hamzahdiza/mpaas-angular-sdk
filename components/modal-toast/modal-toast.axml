        bodyClassName="modal-body-px"
      >
        <view slot="footer" class="modal-all-content-px">
          <view class="modal-modal-title-body-content-px">
            <view class="modal-content-container-px">
              <view class="modal-image-error-icon-px" />
              <view slot="title" class="modal-title-px">
                {{title}}
              </view>
            </view>
            <view slot="content" class="content-break-px">
              <text class="modal-content-px">
                {{content}}
              </text>
            </view>
          </view>
          <bni-button type="primary" className="bg-turquoise-300" onTap="closeModalHandler">
            {{btnText}}
          </bni-button>
        </view>
      </modal>
    </view>
  </view>

  <view a:elif="{{ language === 'EN' }}">
    <view a:if="{{ type === 'success' }}">
      <modal
        visible="{{showToast}}"
        onClose="successHandler"
        maskClassName="modal-mask-style-px"
        bodyClassName="modal-body-px"
      >
        <view slot="footer" class="modal-all-content-px">
          <view class="modal-modal-title-body-content-px">
            <view class="modal-content-container-px">
              <view class="modal-image-success-icon-px" />
              <view slot="title" className="txt-h3-px">
                Successfully Set the Period's Beginning
              </view>
            </view>
            <view slot="content" class="content-break-px">
              <text class="modal-content-px">
                Please note, the start of the regulated period will affect your
              </text>
              <text class="modal-content-bold-px">
                Insights and Transaction Reports.
              </text>
            </view>
          </view>
          <bni-button type="primary" className="bg-turquoise-300" onTap="successHandler">
            Ok, I get it
          </bni-button>
        </view>
      </modal>
    </view>
    <view a:elif="{{ type === 'error' }}">
      <modal
        visible="{{showToast}}"
        onClose="closeModalHandler"
        maskClassName="modal-mask-style-px"
        bodyClassName="modal-body-px"
      >
        <view slot="footer" class="modal-all-content-px">
          <view class="modal-modal-title-body-content-px">
            <view class="modal-content-container-px">
              <view class="modal-image-error-icon-px" />
              <view slot="title" class="modal-title-px">
                Failed to Set the Period's Start
              </view>
            </view>
            <view slot="content" class="content-break-px">
              <text class="modal-content-px">
                Please try again; setting was unsuccessful due to a system problem.
              </text>
            </view>
          </view>
          <bni-button type="primary" className="bg-turquoise-300" onTap="closeModalHandler">
            Try Again
          </bni-button>
        </view>
      </modal>
    </view>
  </view>

  <view a:elif="{{ !language }}">
    <modal
      visible="{{showToast}}"
      onClose="closeModalHandler"
      maskClassName="modal-mask-style-px"
      bodyClassName="modal-body-px"
    >
      <view slot="footer" class="modal-all-content-px">
        <view class="modal-modal-title-body-content-px">
          <view class="modal-content-container-px">
            <view slot="title" class="modal-title-px">
              <slot name="modal-title" />
            </view>
          </view>
          <view slot="content" style="margin-bottom:10px;">
            <text class="modal-content-px">
              <slot name="modal-content" />
            </text>
          </view>
        </view>
        <slot name="modal-footer" />
      </view>
    </modal>
  </view>


  <view
    a:if="{{ type === 'custorm' && showToast && !fullscreen}}"
    class="mask-px"
    style="z-index:{{extStyle.zIndex}};"
    disable-scroll="{{true}}"
  >
  </view>
  <scroll-view
    a:if="{{ type === 'custorm' && showToast }}"
    scroll-y="{{true}}"
    style="top:{{extStyle.fullHeight}};z-index:{{extStyle.zIndex+1}}"
    class="{{fullscreen ? 'dialog__wrap_fullscreen-px':'dialog__wrap-px'}}"
  >
    <view class="dialog__container-px" disable-scroll="{{true}}">
      <view class="dialog__title-px">
        <view a:if="{{title === 'Your Title'}}">
          <slot name="title" />
        </view>
        <view a:else>
          {{title}}
        </view>
      </view>
      <view class="dialog__content-px">
        <view a:if="{{content === 'Your content text should be here'}}">
          <slot name="content" />
        </view>
        <view a:else>
