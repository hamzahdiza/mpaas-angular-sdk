      </view>
      <view>
        <view a:if="{{ btnText === 'Button Text' && !btnText2 }}">
          <slot name="button__group" />
        </view>
        <view a:else class="dialog__button__group-px">
          <bni-button
            type="primary"
            className="txt-label1-sb-px bg-turquoise-300"
            onTap="onPrimary"
            pixel
          >
            {{btnText}}
          </bni-button>
          <bni-button type="outline" onTap="onDefault" className="txt-label4-sb-px border-gray" pixel>
            {{btnText2}}
          </bni-button>
        </view>
      </view>
    </view>
  </scroll-view>
</block>