.mask-px {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
}

.dialog__wrap-px {
  position: fixed;
  bottom: 5%;
  z-index: 1000;
  background: #FFFFFF;
  border-radius: 16px;
  width: 327px;
  margin: 0 24px;
  max-height: 86vh;
}

.dialog__wrap_fullscreen-px {
  position: fixed;
  z-index: 1000;
  background: #FFFFFF;
  width: 100%;
  bottom: 0%;
  overflow: hidden;
  height: 100%;
}

.dialog__container-px {
  padding: 24px 16px;
  height: 100%;
}

.dialog__title-px {
  color: #0E0E0E;
  font-family: TT Interphases Pro;
  margin-bottom: 8px;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 18px;
  font-style: normal;
  font-weight: 600;
  line-height: 120%;
}

.dialog__content-px {
  color: #0E0E0E;
  margin-bottom: 24px;
  overflow-y: scroll;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  height: 100%;
}

.dialog__button__group-px>button:first-child {
  margin-bottom: 8px;
}