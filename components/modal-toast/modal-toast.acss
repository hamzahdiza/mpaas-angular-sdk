.modal-body {
  display: flex;
  /* margin-top: 210rpx; */
  width: 654rpx;
  height: 344rpx;
  padding: 48rpx 32rpx;
  flex-direction: column;
  align-items: center;
  border-radius: 32rpx;
  box-shadow: 0rpx 12.5rpx 32rpx 0rpx rgba(78, 78, 78, 0.27);
  position: relative;
  top: 400rpx;
  z-index: 3;
}

.modal-all-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

.modal-title-body-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
}

.modal-content-container {
  display: flex;
  flex-direction: row;
  align-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.modal-title {
  color: #0E0E0E;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 43.2rpx;
  word-wrap: break-word;
}

.modal-content {
  color: #0E0E0E;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 39.2rpx;
  word-wrap: break-word;
  margin-right: 12.5rpx;
}

.modal-content-bold {
  color: #0E0E0E;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 39.2rpx;
  word-wrap: break-word;
  margin-right: 12.5rpx;
}

.content-break {
  margin-bottom: 48rpx;
}

.modal-button {
  display: flex;
  padding: 24rpx 64rpx;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  word-wrap: break-word;
  line-height: 33.6rpx;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: 64rpx;
}

.modal-mask-style {
  display: flex;
  padding-bottom: 0rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: rgba(14, 14, 14, 0.80);
  z-index: 0;
}

.modal-image-success-icon {
  display: flex;
  height: 64rpx;
  width: 64rpx;
  margin-right: 16rpx;
  background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2232%22%20height%3D%2232%22%20viewBox%3D%220%200%2032%2032%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20id%3D%22General%2Fic_common_check_filled%22%3E%3Cpath%20id%3D%22Icon%22%20d%3D%22M16.0003%202.66602C8.66699%202.66602%202.66699%208.66602%202.66699%2015.9993C2.66699%2023.3327%208.66699%2029.3327%2016.0003%2029.3327C23.3337%2029.3327%2029.3337%2023.3327%2029.3337%2015.9993C29.3337%208.66602%2023.3337%202.66602%2016.0003%202.66602ZM14.4003%2021.5993C13.867%2021.5993%2013.467%2021.466%2013.067%2021.066L7.86699%2015.9993L9.73366%2014.1327L14.4003%2018.7994L22.4003%2010.7993L24.267%2012.666L15.7337%2021.1993C15.3337%2021.466%2014.8003%2021.5993%2014.4003%2021.5993Z%22%20fill%3D%22%2302C794%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
  background-size: cover;
  background-repeat: no-repeat;
}

.modal-image-error-icon {
  display: flex;
  height: 64rpx;
  width: 64rpx;
  margin-right: 16rpx;
  background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2232%22%20height%3D%2232%22%20viewBox%3D%220%200%2032%2032%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20id%3D%22General%2Fic_common_error_filled%22%3E%3Cpath%20id%3D%22Icon%22%20d%3D%22M16.0003%202.66602C8.66699%202.66602%202.66699%208.66602%202.66699%2015.9993C2.66699%2023.3327%208.66699%2029.3327%2016.0003%2029.3327C23.3337%2029.3327%2029.3337%2023.3327%2029.3337%2015.9993C29.3337%208.66602%2023.3337%202.66602%2016.0003%202.66602ZM16.0003%2023.9993C15.2003%2023.9993%2014.667%2023.466%2014.667%2022.666C14.667%2021.866%2015.2003%2021.3327%2016.0003%2021.3327C16.8003%2021.3327%2017.3337%2021.866%2017.3337%2022.666C17.3337%2023.466%2016.8003%2023.9993%2016.0003%2023.9993ZM17.3337%2018.666H16.0003H14.667V7.99935H16.0003H17.3337V18.666Z%22%20fill%3D%22%23D65C5C%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
  background-size: cover;
  background-repeat: no-repeat;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
}

.dialog__wrap {
  position: fixed;
  bottom: 5%;
  z-index: 1000;
  background: #FFFFFF;
  border-radius: 32rpx;
  width: 654rpx;
  margin: 0 48rpx;
  max-height: 86vh;
}

.dialog__wrap_fullscreen {
  position: fixed;
  z-index: 1000;
  background: #FFFFFF;
  width: 100%;
  bottom: 0%;
  overflow: hidden;
  height: 100%;
}

.dialog__container {
  padding: 48rpx 32rpx;
  height: 100%;
}

.dialog__title {
  color: #0E0E0E;
  font-family: TT Interphases Pro;
  margin-bottom: 16rpx;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 36rpx;
  font-style: normal;
  font-weight: 600;
  line-height: 120%;
}

.dialog__content {
  color: #0E0E0E;
  margin-bottom: 48rpx;
  overflow-y: scroll;
  font-feature-settings: 'clig'off, 'liga'off;
  font-family: TT Interphases Pro;
  font-size: 28rpx;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  height: 100%;
}

.dialog__button__group>button:first-child {
  margin-bottom: 16rpx;
}

/* PIXEL MODE */

.modal-body-px {
  display: flex;
  /* margin-top: 210rpx; */
  width: 327px;
  height: 172px;
  padding: 24px 16px;
  flex-direction: column;
  align-items: center;
  border-radius: 16px;
  box-shadow: 0px 6.25px 16px 0px rgba(78, 78, 78, 0.27);
  position: relative;
  top: 200px;
  z-index: 3;
}

.modal-all-content-px {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

.modal-title-body-content-px {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
}

.modal-content-container-px {
  display: flex;
  flex-direction: row;
  align-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.modal-title-px {
  color: #0E0E0E;
  font-size: 20px;
  font-weight: 800;
  line-height: 21.6px;
  word-wrap: break-word;
}

.modal-content-px {
  color: #0E0E0E;
  font-size: 16px;
  font-weight: 400;
  line-height: 19.6px;
  word-wrap: break-word;
  margin-right: 6.25px;
}

.modal-content-bold-px {
  color: #0E0E0E;
  font-size: 16px;
  font-weight: 600;
  line-height: 9.8px;
  word-wrap: break-word;
  margin-right: 6.25px;
}

.content-break-px {
  margin-bottom: 24px;
}

.modal-button-px {
  display: flex;
  padding: 12px 32px;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  font-weight: 600;
  word-wrap: break-word;
  line-height: 16.8px;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: 32px;
}

.modal-mask-style-px {
  display: flex;
  padding-bottom: 0px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: rgba(14, 14, 14, 0.80);
  z-index: 0;
}

.modal-image-success-icon-px {
  display: flex;
  height: 32px;
  width: 32px;
  margin-right: 8px;
  background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2232%22%20height%3D%2232%22%20viewBox%3D%220%200%2032%2032%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20id%3D%22General%2Fic_common_check_filled%22%3E%3Cpath%20id%3D%22Icon%22%20d%3D%22M16.0003%202.66602C8.66699%202.66602%202.66699%208.66602%202.66699%2015.9993C2.66699%2023.3327%208.66699%2029.3327%2016.0003%2029.3327C23.3337%2029.3327%2029.3337%2023.3327%2029.3337%2015.9993C29.3337%208.66602%2023.3337%202.66602%2016.0003%202.66602ZM14.4003%2021.5993C13.867%2021.5993%2013.467%2021.466%2013.067%2021.066L7.86699%2015.9993L9.73366%2014.1327L14.4003%2018.7994L22.4003%2010.7993L24.267%2012.666L15.7337%2021.1993C15.3337%2021.466%2014.8003%2021.5993%2014.4003%2021.5993Z%22%20fill%3D%22%2302C794%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
  background-size: cover;
  background-repeat: no-repeat;
}

.modal-image-error-icon-px {
  display: flex;
  height: 32px;
  width: 32px;
  margin-right: 8px;
  background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2232%22%20height%3D%2232%22%20viewBox%3D%220%200%2032%2032%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20id%3D%22General%2Fic_common_error_filled%22%3E%3Cpath%20id%3D%22Icon%22%20d%3D%22M16.0003%202.66602C8.66699%202.66602%202.66699%208.66602%202.66699%2015.9993C2.66699%2023.3327%208.66699%2029.3327%2016.0003%2029.3327C23.3337%2029.3327%2029.3337%2023.3327%2029.3337%2015.9993C29.3337%208.66602%2023.3337%202.66602%2016.0003%202.66602ZM16.0003%2023.9993C15.2003%2023.9993%2014.667%2023.466%2014.667%2022.666C14.667%2021.866%2015.2003%2021.3327%2016.0003%2021.3327C16.8003%2021.3327%2017.3337%2021.866%2017.3337%2022.666C17.3337%2023.466%2016.8003%2023.9993%2016.0003%2023.9993ZM17.3337%2018.666H16.0003H14.667V7.99935H16.0003H17.3337V18.666Z%22%20fill%3D%22%23D65C5C%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E');
