.container {
  background-color: white;
}

.pickerContainer {
  padding: 0 24px;
  height: 184px;
}

.indicatorStyle {
  border: none;
  width: 0px;
}

.columnStyle {
  max-width: 20px;
  max-height: 22px;
}

.txt-blue {
  color: blue;
}

.faded-opacity {
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 1) 50%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 1) 50%,
    rgba(0, 0, 0, 0) 100%
  );

  mask-mode: alpha;
  -webkit-mask-mode: alpha;

  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;

  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
}