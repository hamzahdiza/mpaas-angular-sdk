/* START PROGRESS LINE */
.progress-line {
  width: 100%;
  height: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.progress-steps {
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

/*  */
/* First animation */
@keyframes progress-animation-1 {
  from {
    width:  var(--from-width,0);
  }
  to {
    width: var(--width);
  }
}

/* Second animation */
@keyframes progress-animation-2 {
  from {
    width: var(--from-width,0);
  }
  to {
    width: var(--width);
  }
}

.progress-fill {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 8rpx;
  border-top-right-radius: 8rpx;
}
.progress-fill {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 8rpx;
  border-top-right-radius: 8rpx;
  animation: progress-animation 0.5s ease-in-out forwards;
}

@keyframes progress-animation {
  from {
    width: 0;
  }

  to {
    width: var(--width);
  }
}

.progress-fill-steps {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 8rpx;
  border-top-right-radius: 8rpx;
}

/* Initially, you can have either animation-1 or animation-2 applied */
.animation-1 {
  animation: progress-animation-1 0.5s ease-in-out forwards;
}

.animation-2 {
  animation: progress-animation-2 0.5s ease-in-out forwards;
}

/*  */
.progress-txt {
  position: absolute;
  top: 50%;
  right: 20rpx;
  transform: translateY(-50%);
}

/* END PROGRESS LINE */



/* START PROGRESS CIRCLE */
.circular-progress {
  position: relative;
  height: 74rpx;
  width: 74rpx;
  border-radius: 49%;
  background: var(--lime-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circular-progress::before {
  content: "";
  position: absolute;
  height: 60rpx;
  width: 60rpx;
  border-radius: 50%;
  background-color: var(--white);
  z-index: 1;
  box-shadow: none;
}

.progress-value {
  position: relative;
  z-index: 1;
}

/* .ant-progress-circle .ant-progress-indicator {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 28.8rpx;
} */

/* END PROGRESS CIRCLE */

/* 自定义 */
.circle-wrap {
  width: 96rpx;
  height: 96rpx;
  box-sizing: border-box;
  position: relative;
}

.rect-left,
.rect-right {
  width: 48rpx;
  height: 96rpx;
  overflow: hidden;
}

.rect-left {
  position: absolute;
  top: 0;
  left: 0;
}

.rect-right {
  position: absolute;
  top: 0;
  left: 48rpx;
}

.circle-left,
.circle-right {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.circle-left {
  border-bottom: 12rpx solid #F9F9F9;
  border-left: 12rpx solid #F9F9F9;
  border-top-style: solid;
  border-right-style: solid;
  border-top-width: 12rpx;
  border-right-width: 12rpx;
}

.circle-right {
  border-top: 12rpx solid #F9F9F9;
  border-right: 12rpx solid #F9F9F9;
  border-left-style: solid;
  border-bottom-style: solid;
  border-left-width: 12rpx;
  border-bottom-width: 12rpx;
  margin-left: -48rpx;
}

/* 进度文字 */
.progress-text {
  position: absolute;
  color: #0E0E0E;
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  top: 34rpx;
  left: 24rpx;

  font-family: TT Interphases Pro;
  font-size: 24rpx;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.circle-text {
  color: var(--functional-bw-tones-black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;

  font-family: "TT Interphases Pro";
  font-size: 24rpx;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.progress-circle-fill {
  border-style: solid;
  border-width: 10rpx;
  border-radius: 50%;
  /* box-sizing: border-box; */
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-position {
  position: absolute;
  top: 50%;
  left: 50%;
}

/* PIXEL MODE */

/* START PROGRESS LINE */
.progress-line-px {
  width: 100%;
  height: 20px;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

.progress-steps-px {
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

/*  */
/* First animation */
@keyframes progress-animation-1 {
  from {
    width:  var(--from-width,0);
  }
  to {
    width: var(--width);
  }
}

/* Second animation */
@keyframes progress-animation-2 {
  from {
    width: var(--from-width,0);
  }
  to {
    width: var(--width);
  }
}

.progress-fill-px {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 4px;
  border-top-right-radius: 4px;
}
.progress-fill-px {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 4px;
  border-top-right-radius: 4px;
  animation: progress-animation 0.5s ease-in-out forwards;
}

@keyframes progress-animation {
  from {
    width: 0;
  }

  to {
    width: var(--width);
  }
}

.progress-fill-steps-px {
  width: var(--width);
  height: 100%;
  border-end-end-radius: 4px;
  border-top-right-radius: 4px;
}

/* Initially, you can have either animation-1 or animation-2 applied */
.animation-1-px {
  animation: progress-animation-1 0.5s ease-in-out forwards;
}

.animation-2-px {
  animation: progress-animation-2 0.5s ease-in-out forwards;
}

/*  */
.progress-txt-px {
  position: absolute;
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
}

/* END PROGRESS LINE */



/* START PROGRESS CIRCLE */
.circular-progress-px {
  position: relative;
  height: 37px;
  width: 37px;
  border-radius: 49%;
  background: var(--lime-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circular-progress-px::before {
  content: "";
  position: absolute;
  height: 30px;
  width: 30px;
  border-radius: 50%;
  background-color: var(--white);
  z-index: 1;
  box-shadow: none;
}

.progress-value-px {
  position: relative;
  z-index: 1;
}

.ant-progress-circle .ant-progress-indicator {
  font-size: 12px;
  font-weight: 700;
  line-height: 14.4px;
}

/* END PROGRESS CIRCLE */

/* 自定义 */
.circle-wrap-px {
  width: 48px;
  height: 48px;
  box-sizing: border-box;
  position: relative;
}

.rect-left-px,
.rect-right-px {
  width: 24px;
  height: 48px;
  overflow: hidden;
}

.rect-left-px {
  position: absolute;
  top: 0;
  left: 0;
}

.rect-right-px {
  position: absolute;
  top: 0;
  left: 24px;
}

.circle-left-px,
.circle-right-px {
  width: 36px;
  height: 36px;
  border-radius: 50%;
}

.circle-left-px {
  border-bottom: 6px solid #F9F9F9;
  border-left: 6px solid #F9F9F9;
  border-top-style: solid;
  border-right-style: solid;
  border-top-width: 6px;
  border-right-width: 6px;
}

.circle-right-px {
  border-top: 6px solid #F9F9F9;
  border-right: 6px solid #F9F9F9;
  border-left-style: solid;
  border-bottom-style: solid;
  border-left-width: 6px;
  border-bottom-width: 6px;
  margin-left: -24px;
}

/* 进度文字 */
.progress-text-px {
  position: absolute;
  color: #0E0E0E;
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  top: 17px;
  left: 24px;

  font-family: TT Interphases Pro;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.circle-text-px {
  color: var(--functional-bw-tones-black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;

  font-family: "TT Interphases Pro";
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.progress-circle-fill-px {
  border-style: solid;
  border-width: 5px;
  border-radius: 50%;
  /* box-sizing: border-box; */
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-position-px {
  position: absolute;
  top: 50%;
  left: 50%;
}