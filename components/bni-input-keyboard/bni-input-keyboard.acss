  mask-image: url('data:image/svg+xml;utf8,<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="General/ic_common_cancel_outlined"><g id="Icon"><path d="M12 22C6.49 22 2 17.51 2 12C2 6.49 6.49 2 12 2C17.51 2 22 6.49 22 12C22 17.51 17.51 22 12 22ZM12 4C7.59 4 4 7.59 4 12C4 16.41 7.59 20 12 20C16.41 20 20 16.41 20 12C20 7.59 16.41 4 12 4Z" fill="%230E0E0E"/><path d="M8.70837 7.29188L7.29416 8.7061L15.2562 16.6681L16.6704 15.2539L8.70837 7.29188Z" fill="%230E0E0E"/><path d="M15.2915 7.30067L7.31537 15.2768L8.72959 16.691L16.7058 8.71488L15.2915 7.30067Z" fill="%230E0E0E"/></g></g></svg>');
