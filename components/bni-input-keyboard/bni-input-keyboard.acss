.bottom-border-px {
  border-top: none;
  border-right: none;
  border-left: none;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-radius: 0;
  padding: 1.5px 0px;
}

.bottom-border-amount-px {
  border-top: none;
  border-right: none;
  border-left: none;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-radius: 0;
}

.amount-clear-icon-px {
  width: 24px;
  height: 24px;
  margin-left: 8px;
}

.amount-gap-px {
  width: 35px;
}

.clear-container-px {
  margin-right: 0;
  height: 24px;
  width: 32px;
}

.prefix-icon-gap-px {
  margin-right: 0px;
  display: flex;
  width: 69px;
  padding: 16px 12px;
  align-items: center;
  font-size: 20px;
  font-style: normal;
  font-weight: 800;
  line-height: 120%;
}

.border-right-gray-px {
  border-right: 1px solid #C6C6C6;
}

.border-right-red-px {
  border-right: 1px solid #D65C5C;
}

.border-right-green-px {
  border-right: 1px solid #3AA8A0;
}

.amount-height-px {
  height: 33.5px;
}


.scroll-view-px {
  max-width: 260px;
}

.scroll-view-usd-px {
  max-width: 225px;
}


.usd-input-cursor-px::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  width: 1px;
  height: 24px;
  background-color: #0e0e0e;
  animation: blink-px 1s infinite steps(1, start);
  font-family: Montserrat;
  font-size: 32px;
  line-height: 40px;
}

.amount-input-position-px {
  text-align: end;
  position: relative;
}

.input-position-usd-px {
  text-align: right;
  position: relative;
}

/* 
  keyboard
*/
.input-keyboard-px {
  width: 100%;
  z-index: 9999;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  position: fixed;
  bottom: 0px;
  left: 0px;
}

.input-keyboard-selesai-px {
  display: flex;
  width: 100%;
  justify-content: flex-end;
  align-items: center;
  background: #F0F0F0;
  height: 34px;
}

.input-keyboard-selesai-text-px {
  display: flex;
  height: 18px;
  padding: 8px 16px;
  justify-content: center;
  align-items: center;
  color: #FF8736;
  text-align: center;
  font-family: TT Interphases Pro;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.input-box-icon-px {
  margin-left: 16px;
  height: 20px;
  width: 20px;
}

.input-box-icon-px:first-child {
  margin-left: 0px
}

.input-keyboard-group-px {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 6px;
  padding-bottom: 57px;
  justify-content: center;
  align-items: center;
  background: #DADADA;
}

.input-keyboard-group-row-px {
  display: flex;
  align-items: center;
  margin-top: 8px
}

.input-keyboard-group-row-px:first-child {
  margin-top: 0px;
}

.input-keyboard-group-button-px {
  display: flex;
  height: 45px;
  width: 122px;
  border-radius: 4px !important;
  padding: 8px 8px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #0e0e0e;
  text-align: center;
  font-size: 24px;
  font-weight: 700;
  line-height: 120%;
  margin-left: 4px;
}

.input-keyboard-group-button-px:first-child {
  margin-left: 0px;
}

.input-keyboard-delete-button-box-px {
  display: flex;
  height: 45px;
  width: 122px;
  /* padding: 8px; */
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #0E0E0E;
  text-align: center;
  margin-left: 4px;
}

.input-keyboard-group-delete-button-px {
  background: #DADADA;
  border: 0px;
  display: flex;
  width: 32px;
  height: 30px;
  justify-content: center;
  align-items: center;
  color: #0E0E0E;
  text-align: center;
}

.input-amount-popup-px {
  height: 301px;
  position: fixed;
  bottom: 0;
}


.clear-input-icon-container-px {
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  width: 1px;
}

.clear-input-icon-container-blink-px {
  animation: blink-border-px 1s infinite steps(1, start);
  border-left: solid 1px #0e0e0e;
  justify-self: flex-end;
  flex-grow: 1;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  width: 1px;
}

@keyframes blink-px {
  50% {
    opacity: 0;
  }
}

@keyframes blink-border-px {
  50% {
    border-left-color: #fff;
  }

  100% {
    border-left-color: #0e0e0e;
  }
}


.popover-content-px::after {
  content: "";
  transform: translate(-50%, 100%) rotate(180deg);
  left: 50%;
  bottom: 1px;
  position: absolute;
  width: 0;
  height: 0;
  border-bottom: 8.5px solid black;
  border-left: 8.5px solid transparent;
  border-right: 8.5px solid transparent;
  z-index: 1;
}

.popover-container-px {
  position: absolute;
  background: black;
  z-index: 9999;
  width: 100px;
  color: white;
  bottom: 0;
  left: 50%;
  right: 50%;
  transform: translate(-50%, -50%);
  border-radius: 5px;
  padding: 5px;
}

.popover-content-px {
  display: flex;
  justify-content: space-around;
}

.pointer-events-none-px {
  pointer-events: none;
}

.amount-input-placeholder-px {
  color: #a0a0a0;
}

.amount-input-container-px {
  display: flex;
  flex-direction: row;
}

