.main-comp-container {
  display: grid;
  margin-top: 24px;
  grid-template-rows: 3;
  row-gap: 16px;
}

.container-info {
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  background-color: #f9f9f9;
  border-radius: 16px;
  display: flex;
  justify-content: space-between
}

.graph-canvas {
  width: 100%;
  padding-top: 20px;
}

canvas {
  width: 100%;
  height: 140px;
  display: block;
}

.info-area {
  width: calc(50% - 17px);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-area>.title {
  margin-bottom: 4px;
  margin-top: 0px !important;
}
.vertical-line{
  height: 100%;
  border-right: 1px solid #DADADA;
}

.max-mark {
  width: 100%;
  height: 17px;
  box-sizing: border-box;
}

.min-mark {
  width: 100%;
  box-sizing: border-box;
  height: 17px;
}

.x-axis-label {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
}

#goldPriceDetailScreenPerfomanceTooltipIcon{
  height:12px;width:12px;
}


