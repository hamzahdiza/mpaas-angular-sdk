.card-product {
  margin-bottom: 16px;
  display: flex;
  padding: 16px;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;

  border-radius: 16px;
  border: 1px solid var(--functional-bw-tones-pale-gray, #DADADA);
  background: #fff;
}

.title-product {
  display: flex;
  align-items: flex-start;
  height: 37px;
  align-self: stretch;
}

.container-product-name {
  margin-left: 8px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
}

.type-product {
  display: flex;
  align-items: flex-start;
  align-content: flex-start;
  align-self: stretch;

  color: var(--functional-bw-tones-granite-gray, #7A7A7A);
}

.divider {
  width: 100%;
  height: 1px;
  background: #DADADA;
  margin-top: 12px;
}

.remain-kuota {
  margin-bottom: 12px;
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  align-self: stretch;
}

.amount-kuota {
  text-align: end;
}

.container-info {
  margin-top: 12px;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
  height: 36px
}

.info-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 36px;
  align-self: stretch;
  width: 100%;
}

.container-title-detail {
  display: flex;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  margin-bottom: 8px;
}

.title-detail {
  margin-left: 4px;
  white-space: nowrap;
}

.container-detail {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-self: stretch;
  text-align: center;
}

.divider-info {
  height: 36px;
  margin-left: 8px;
  margin-right: 8px;
  border-left: solid 0.5px #DADADA;
}

.container-remain-kuota {
  display: flex;
  align-self: stretch;
  width: 100%;
}

.space {
  margin-left: 3px;
}