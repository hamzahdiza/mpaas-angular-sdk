<view class="card-product" onTap="cardOnTap" id="product-{{dataProduct.productId}}">
  <view class="title-product">
    <image
      onError="checkIconBroken"
      mode="scaleToFill"
      style="width:32px; height:32px"
      src="{{dataProduct.image}}"
      id="bonds-booking-product-list-{{status}}-image"
      data-id="{{dataProduct.id}}"
    />
    <view class="container-product-name">
      <view class="txt-body2-sb" id="bonds-booking-product-list-{{status}}-series">
        {{dataProduct.seri}}
      </view>
      <view class="type-product txt-body3" id="bonds-booking-product-list-available-{{status}}-name">
        {{dataProduct.seriName}} {{` • `}} {{dataProduct.currency}}
      </view>
    </view>
  </view>

  <!-- Offer Available -->
  <view a:if="{{ status == 'available' }}" style="width:100%">

    <!-- remainingQuotaPercentage -->
    <view style="width:100%">
      <view class="remain-kuota">
        <view class="container-remain-kuota" id="bonds-booking-product-list-available-remaining-national-quota">
          <view class="txt-body3">
            {{lang.bondsBookingProductListRemainingQuota}}
          </view>
          <view class="space txt-body3-sb">
            {{dataProduct.remainingQuotaNationalFormatted}}
          </view>
        </view>
        <view class="amount-kuota txt-body3-sb" id="bonds-booking-product-list-available-percentage-remaining-national-quota">
          {{dataProduct.remainingQuotaPercentageFormatted}}%
        </view>
      </view>

      <view style="height:8px">
        <progress-bar
        id="bonds-booking-product-list-available-bar-remaining-national-quota"
        type="steps"
        width="100%"
        height="8px"
        percent={{100 - dataProduct.remainingQuotaPercentageFormatted}}
        backgroundColor="#F0F0F0"
        progressColor={{dataProduct.quotaUsedPercentageColor}}
        />
      </view>
    </view>

    <view class="divider" />

    <view class="container-info">
      <view class="info-detail">
        <view class="container-title-detail">
          <image mode="widthFix" style="width:16px" src="../../assets/icons/ic_common_return.svg" id="bonds-booking-product-list-available-coupon-rate-icon"/>
          <view class="title-detail txt-label2-sb txt-charcoal" id="bonds-booking-product-list-available-coupon-rate-label">
            {{lang.bondsBookingProductListCouponRate}}
          </view>
        </view>
        <view class="container-detail txt-label2-sb txt-emerald-400" id="bonds-booking-product-list-available-coupon-rate-value">
          {{dataProduct.couponRate}}
        </view>
      </view>

      <view class="divider-info" />
      
      <view class="info-detail">
        <view class="container-title-detail">
          <image mode="widthFix" style="width:16px" src="../../assets/icons/ic_common_calendar_month.svg" id="bonds-booking-product-list-available-puchase-period-icon"/>
          <view class="title-detail txt-label2-sb txt-charcoal" id="bonds-booking-product-list-available-purchase-period-label">
            {{lang.bondsBookingProductListPurchasePeriod}}
          </view>
        </view>
        <view class={{isShrink ? "txt-label3-sb container-detail" : "txt-label2-sb container-detail"}} id="bonds-booking-product-list-available-puchase-period-value">
          {{dataProduct.startDateFormatted}} - {{dataProduct.endDateFormatted}}
        </view>
      </view>
    </view>

  </view>

  <!-- Coming Soon -->
  <view a:if="{{ status == 'incoming' }}" style="width:100%">
    <view class="divider" />
    
    <view class="container-info">
      <view class="info-detail">
        <view class="container-title-detail">
          <image mode="widthFix" style="width:16px" src="../../assets/icons/ic_common_investment_management.svg" id="bonds-booking-product-list-incoming-coupon-type-icon"/>
          <view class="title-detail txt-label2-sb txt-charcoal" id="bonds-booking-product-list-incoming-coupon-type-label">
            {{lang.bondsBookingProductListCouponType}}
          </view>
        </view>
        <view class="container-detail txt-label2-sb" id="bonds-booking-product-list-incoming-coupon-type-value">
          {{dataProduct.couponType}}
        </view>
      </view>

      <view class="divider-info" />
      
      <view class="info-detail">
        <view class="container-title-detail">
          <image mode="widthFix" style="width:16px" src="../../assets/icons/ic_common_calendar_month.svg" id="bonds-booking-product-list-incoming-purchase-period-icon"/>
          <view class="title-detail txt-label2-sb txt-charcoal" id="bonds-booking-product-list-incoming-purchase-period-label">
            {{lang.bondsBookingProductListPurchasePeriod}}
          </view>
        </view>
        <view class={{isShrink ? "txt-label3-sb container-detail" : "txt-label2-sb container-detail"}} id="bonds-booking-product-list-incoming-purchase-period-value">
          {{dataProduct.startDateFormatted}} - {{dataProduct.endDateFormatted}}
        </view>
      </view>
    </view>
  </view>

</view>