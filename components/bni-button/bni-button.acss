.bni-button {
  display: flex;
  width: 100%;
  height: 96rpx;
  padding: 24rpx 64rpx;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  align-self: stretch;
  border-radius: var(--rounded-corner-x-large-32-px, 64rpx);
}

.bni-button-compact {
  display: flex;
  height: 64rpx;
  padding: 16rpx 48rpx;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  border-radius: var(--rounded-corner-x-large-32-px, 64rpx);
  width: 100%;
}

.quite {
  display: inline-flex;
  height: 80rpx;
  padding: 16rpx 32rpx;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  background-color: transparent;
  border: none;
}

.quite-compact {
  display: inline-flex;
  height: 68rpx;
  padding: var(--rounded-corner-small-8-px, 16rpx) var(--rounded-corner-medium-16-px, 32rpx);
  justify-content: center;
  align-items: center;
  gap: var(--rounded-corner-x-small-4-px, 8rpx);
  flex-shrink: 0;
  background-color: transparent;
  border: none;
}

.underline {
  text-decoration: underline;
}

.bni-sticky-wrapper {
  position: fixed;
  bottom: 0;
  width: 100%;
  z-index: 999;
}

.bni-sticky-container {
  width: calc(100% - 96rpx);
  padding: 32rpx 48rpx 16rpx 48rpx;
  background: #FFF;
  align-items: flex-start;
  align-items: center;
  display: grid;
  flex-direction: column;
  gap: 16rpx;
}


.shadow-sticky {
  box-shadow: 0rpx -6rpx 20rpx 0rpx rgba(78, 78, 78, 0.15);
}

.indicator-bottom {
  min-height: 66rpx;
}

.button-cover {
  width: 100%;
  display: grid;
  flex-direction: column;
  gap: 16rpx;
}

.outline-none {
  border: none;
}

/* PIXEL MODE */

.bni-button-px {
  display: flex;
  width: 100%;
  height: 48px;
  padding: 12px 32px;
  justify-content: center;
  align-items: center;
  gap: 4px;
  align-self: stretch;
  border-radius: var(--rounded-corner-x-large-32-px, 32px);
}

.bni-button-compact-px {
  display: flex;
  height: 32px;
  padding: 8px 24px;
  justify-content: center;
  align-items: center;
  gap:4px;
  border-radius: var(--rounded-corner-x-large-32-px, 32px);
  width: 100%;
}

.quite-px {
  display: inline-flex;
  height: 40px;
  padding: 8px 16px;
  justify-content: center;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  background-color: transparent;
  border: none;
}

.quite-compact-px {
  display: inline-flex;
  height: 34px;
  padding: var(--rounded-corner-small-8-px, 8px) var(--rounded-corner-medium-16-px, 16px);
  justify-content: center;
  align-items: center;
  gap: var(--rounded-corner-x-small-4-px, 4px);
  flex-shrink: 0;
  background-color: transparent;
  border: none;
}

.underline-px {
  text-decoration: underline;
}

.bni-sticky-wrapper-px {
  position: fixed;
  bottom: 0;
  width: 100%;
  z-index: 999;
}

.bni-sticky-container-px {
  width: calc(100% - 48px);
  padding: 16px 24px 8px 24px;
  background: #FFF;
  align-items: flex-start;
  align-items: center;
  display: grid;
  flex-direction: column;
  gap: 8px;
}


.shadow-sticky-px {
  box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
}

.indicator-bottom-px {
  min-height: 33px;
}

.button-cover-px {
  width: 100%;
  display: grid;
  flex-direction: column;
  gap: 8px;
}

.outline-none-px {
  border: none;
}