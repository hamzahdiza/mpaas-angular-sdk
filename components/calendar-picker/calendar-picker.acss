/* ========================================
   CUSTOM CALENDAR PICKER OVERLAY STYLES
   ======================================== */

.hp-cal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--white);
  z-index: 150;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.hp-cal-header {
  padding: 44px 24px 12px 24px;
  border-bottom: 1px solid var(--pale-gray);
  background-color: var(--white);
  display: grid;
}

.hp-cal-close-row {
  display: grid;
  justify-content: end;
}

.hp-cal-close-icon {
  width: 20px;
  height: 20px;
  padding: 4px;
  cursor: pointer;
}

.hp-cal-title-row {
  display: grid;
  grid-auto-flow: column;
  justify-content: start;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  cursor: pointer;
}

.hp-cal-title-text {
  color: var(--black);
}

.hp-cal-chevron-icon {
  width: 24px;
  height: 24px;
}

.hp-cal-action-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  margin-top: 16px;
}

.hp-cal-action-label {
  color: var(--turquoise-400);
}

.hp-cal-action-reset {
  color: var(--granite);
  cursor: pointer;
}

.hp-cal-action-reset-active {
  color: var(--orange-300) !important;
}

/* Scrollable Calendar Body */
.hp-cal-content {
  padding: 24px;
  flex: 1;
  height: 0;
  min-height: 0;
  overflow-y: scroll;
  box-sizing: border-box;
}

/* --- Date view styles --- */
.hp-cal-month-section {
  margin-bottom: 32px;
}

.hp-cal-month-header {
  color: var(--black);
  margin-bottom: 16px;
  display: block;
}

.hp-cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  margin-bottom: 8px;
}

.hp-cal-weekday {
  color: var(--gray);
}

.hp-cal-days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 2px;
}

.hp-cal-day-cell {
  position: relative;
  width: 100%;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  box-sizing: border-box;
  margin: 4px 0;
}

.hp-cal-day-num {
  font-size: 13px;
  font-weight: 400;
  color: var(--black);
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  border-radius: 8px;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.hp-cal-day-offset {
  visibility: hidden;
  pointer-events: none;
}

.hp-cal-day-disabled {
  pointer-events: none;
}

.hp-cal-day-disabled .hp-cal-day-num {
  color: var(--pale-gray) !important;
}

.hp-cal-day-selected .hp-cal-day-num {
  background-color: var(--turquoise-400);
  color: var(--white) !important;
}

.hp-cal-day-selected-start .hp-cal-day-num {
  background-color: var(--turquoise-400);
  color: var(--white) !important;
  border-radius: 8px; /* full radius when no end selected yet */
}

/* When range is complete: start = left corners only */
.hp-cal-has-range .hp-cal-day-selected-start .hp-cal-day-num {
  border-radius: 8px 0 0 8px;
}

.hp-cal-has-range .hp-cal-day-selected-start::after {
  content: '';
  position: absolute;
  left: 50%;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: var(--turquoise-100);
  z-index: 1;
}

.hp-cal-day-selected-end .hp-cal-day-num {
  background-color: var(--turquoise-400);
  color: var(--white) !important;
  border-radius: 0 8px 8px 0; /* right corners only */
}

.hp-cal-has-range .hp-cal-day-selected-end::after {
  content: '';
  position: absolute;
  left: 0;
  right: 50%;
  top: 0;
  bottom: 0;
  background-color: var(--turquoise-100);
  z-index: 1;
}

.hp-cal-day-range-in {
  background-color: var(--turquoise-100);
}

.hp-cal-day-range-in .hp-cal-day-num {
  color: var(--turquoise-400);
  border-radius: 0;
}

.hp-cal-today-label {
  position: absolute;
  top: 8px;
  font-size: 10px;
  color: var(--granite);
  white-space: nowrap;
  z-index: 3;
  line-height: 1;
}

.hp-cal-day-selected-start .hp-cal-today-label,
.hp-cal-day-selected-end .hp-cal-today-label,
.hp-cal-day-selected .hp-cal-today-label {
  color: var(--white) !important;
}

.hp-cal-today-num {
  font-weight: 400;
  padding-top: 8px; /* Shift number down slightly to offset today label */
}

/* --- Month view styles --- */
.hp-cal-year-section {
  margin-bottom: 32px;
}

.hp-cal-year-header {
  color: var(--black);
  margin-bottom: 16px;
  display: block;
}

.hp-cal-months-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px 12px;
}

.hp-cal-month-cell {
  padding: 12px 0;
  border-radius: 24px;
  display: grid;
  place-items: center;
  color: var(--black);
  cursor: pointer;
  box-sizing: border-box;
}

.hp-cal-month-active {
  background-color: var(--turquoise-400);
  color: var(--white) !important;
}

.hp-cal-month-disabled {
  color: var(--pale-gray);
  pointer-events: none;
}

/* --- Calendar Footer --- */
.hp-cal-footer {
  padding: 16px 24px 24px 24px;
  background-color: var(--white);
  border-top: 1px solid var(--snow-white);
  display: block;
}

.hp-cal-save-btn {
  width: 100%;
  padding: 14px 0;
  border-radius: 100px;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
}

.hp-cal-save-disabled {
  background-color: var(--pale-gray);
  color: var(--gray) !important;
  pointer-events: none;
}

.hp-cal-save-active {
  background-color: var(--turquoise-300);
  color: var(--black) !important;
}

.hp-cal-save-text {
  color: inherit;
}
