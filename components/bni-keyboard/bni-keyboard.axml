<view key="bni-number-input-{{$id}}" class="bni-number-keyboard">
  <view 
    a:if="{{isOpen}}" 
    class="bni-number-keyboard-modal" 
    onTap="{{ (dismissEverywhere || ctaPosition === 'none') ? 'handleHide' : '' }}"
  >
  </view>
  
  <!-- Custom Keyboard -->
  <view a:if={{ type === 'custom' }} class="bni-number-keyboard-kb {{ctaPosition === 'top' ? 'bni-number-keyboard-with-top-cta' : (ctaPosition === 'bottom' ? 'bni-number-keyboard-with-bottom-cta' : '') }} {{isOpen ? '' : 'bni-number-keyboard-kb_hide'}}">
    
    <!-- CTA Top (Hanya jika ctaPosition === 'top') -->
    <view a:if="{{ctaPosition === 'top'}}" class="bni-number-keyboard-kb_none">
      <view onTap="handleHide" class="bni-number-keyboard-label-top">
        <text>{{ctaLabel}}</text>
      </view>
    </view>

    <view class="bni-number-keyboard-kb_bd">
      <view class="bni-number-keyboard-kb_keys">
        <block a:for={{numArr}} a:for-index="index" a:for-item="item">
          <view class="bni-number-keyboard-kb_row">
            <block a:for="{{item}}" a:for-index="index" a:for-item="itemKey">
              <view
                data-key="{{itemKey}}"
                class="bni-number-keyboard-kb_number"
                onTap="handlePressDownNumber"
              >
                {{itemKey}}
              </view>
            </block>
          </view>
        </block>
        <view class="bni-number-keyboard-kb_row">
          <!-- Bottom Left Type -->
          <block>
            <view a:if={{ bottomLeftButtonType === 'empty' }} class="bni-number-keyboard-kb_number bni-number-keyboard-kb_empty bni-number-keyboard-kb_flex" />
            <view
              a:if={{ bottomLeftButtonType === 'decimal' }}
              class="bni-number-keyboard-kb_number bni-number-keyboard-kb_flex"
              onTap="handlePressDownNumber"
              data-key={{ language === 'id' ? ',' : '.' }}
            >
              {{ language === 'id' ? ',' : '.' }}
            </view>
            <view
              a:if={{ bottomLeftButtonType === 'thousand' }}
              class="bni-number-keyboard-kb_number bni-number-keyboard-kb_flex"
              onTap="handlePressDownNumber"
              data-key='000'
            >
              000
            </view>
          </block>
          <view
            class="bni-number-keyboard-kb_number bni-number-keyboard-kb_flex"
            onTap="handlePressDownNumber"
            data-key='0'
          >
            0
          </view>
          <view
            id="delete-button-box"
            class="bni-number-keyboard-kb_number   
            bni-number-keyboard-kb_del bni-number-keyboard-kb_flex"
            data-key="del"
            onTap="handlePressDownNumber"
          >
            <view class="delete-icon" />
          </view>
        </view>
      </view>
    </view>

    <view class="{{ ctaPosition === 'none' ? 'bni-number-keyboard-button-container-none': 'bni-number-keyboard-button-container'}}">
      <view a:if="{{ ctaPosition === 'bottom' }}" class="button-done" catchTap="handleHide">
        <bni-button pixel className="txt-label1-sb-px bg-turquoise-300">
          {{ctaLabel}}
        </bni-button>
      </view>
    </view>
  </view>

  <!-- Numeric Keyboard -->
  <view a:if={{ type === 'numeric' }}>
    <ant-number-keyboard
      visible={{isOpen}}
      point="{{false}}"
      value={{value}}
      onChange="handlePressDownNumber"
      onClose="handleHide"
    />
  </view>
</view>