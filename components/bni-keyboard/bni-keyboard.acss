.bni-number-keyboard {
  color: #333;
  width: 0;
  height: 0;
  position: relative;
  overflow: hidden
}

.bni-number-keyboard-with-top-cta {
  height: 338px;
}

.bni-number-keyboard-with-bottom-cta {
  height: 324px
}

.bni-number-keyboard-modal {
  z-index: 998;
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: transparent
}

.bni-number-keyboard-kb {
  background: #DADADA;
  max-height: 600px;
  min-width: 100vw;
  overflow: hidden;
  position: fixed;
  bottom: 0;
  left: 0;
  transition: all .2s linear;
  z-index: 999
}

.bni-number-keyboard-kb_hide {
  transform: translateY(100%);
  max-height: 0
}

.bni-number-keyboard-kb_bd {
  display: flex
}

.bni-number-keyboard-kb_row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  justify-content: space-between;
  width: 100%;
}

.bni-number-keyboard-kb_keys {
  flex: 3; 
  display: grid;
  grid-auto-rows: min-content; 
  gap: 8px;
  padding: 8px;
}

.bni-number-keyboard-kb_none {
  height: 34px;
  width: 100%;
  background-color: #F0F0F0;
  display: flex;
  position: relative;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

.bni-number-keyboard-label-top {
  display: flex;
  height: calc(100% - 16px);
  padding: 8px 16px;
  justify-content: center;
  align-items: center;
  color: var(--Brand-BNI-Orange-Orange-300---Primary, #FF8736);
  text-align: center;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 14.4px */
}

.bni-number-keyboard-kb_number {
  border-radius: 4px;
  background: var(--functional-bw-tones-white, #FFF);
  flex: 1;
  height: calc(45px - 16px);
  padding: 8px;
  text-align: center;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  user-select: none;
  color: var(--functional-bw-tones-black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 2 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 28.8px */
}

.bni-number-keyboard-kb_number:active {
  background-color: #FFDBC3;
}

.bni-number-keyboard-kb_empty {
  background-color: transparent;
}

.bni-number-keyboard-kb_empty:active {
  background-color: transparent;
}

.bni-number-keyboard-kb_zero {
  flex: 2
}

.bni-number-keyboard-kb_point {
  flex: 1
}

.bni-number-keyboard-kb_transfer-btn {
  font-size: 16px;
  font-weight: 700
}

.bni-number-keyboard-kb_transfer:active {
  opacity: .9
}

.bni-number-keyboard-kb_del {
  background-color: transparent;
}

.bni-number-keyboard-kb_flex {
  flex: 1
}

.bni-number-keyboard-button-container {
  padding: 16px 24px;
  padding-bottom: 0px;
}

.bni-number-keyboard-button-container-none {
  padding: 16px 24px;
  padding-bottom: 37px;
}

.delete-icon {
  position: relative;
  width: 32px;
  height: 32px;
  background-color: transparent;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url('data:image/svg+xml;utf8,<svg width="33" height="32" viewBox="0 0 33 32" xmlns="http://www.w3.org/2000/svg"><path fill="%230E0E0E" d="M27.834 6.6665L11.834 6.6665C11.3007 6.6665 10.7673 6.93317 10.3673 7.33317L3.83398 14.6665C3.16732 15.4665 3.16732 16.5332 3.83398 17.3332L10.3673 24.6665C10.7673 25.0665 11.3007 25.3332 11.834 25.3332L27.834 25.3332C28.9007 25.3332 29.834 24.3998 29.834 23.3332L29.834 8.6665C29.834 7.59984 28.9007 6.6665 27.834 6.6665ZM27.1673 22.6665L12.234 22.6665L6.36732 15.9998L12.234 9.33317L27.1673 9.33317L27.1673 22.6665ZM13.5673 18.7998L16.3673 15.9998L13.5673 13.1998L15.434 11.3332L18.234 14.1332L21.034 11.3332L22.9007 13.1998L20.234 15.9998L23.034 18.7998L21.1673 20.6665L18.3673 17.8665L15.5673 20.6665L13.5673 18.7998Z"/></svg>');
}

.ant-number-keyboard-kb_number{
  font-family: "TT Interphases Pro" !important;
}