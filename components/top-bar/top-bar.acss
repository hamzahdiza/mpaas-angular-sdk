.topBar-container {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: -1rpx 0;
}

.topBar-upper-space {
  display: flex;
  width: calc(750rpx - 84rpx);
  padding: 0rpx 42rpx;
  justify-content: space-between;
  align-items: center;
  color: #00000000;
}

.topBar-title-bar {
  display: flex;
  width: calc(750rpx - 96rpx);
  height: calc(112rpx - 24rpx);
  padding: 12rpx 48rpx;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.topBar-container-left-icon {
  width: 48rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  cursor: pointer;
  flex-shrink: 0;
}

.topBar-left-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.topBar-title-container {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-gap: 32rpx;
  align-items: center;
  justify-content: center;
  width: 85.2%;
}

.topBar-title {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.topBar-title-txt {
  width: 100%;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  display: block;
}

.topBar-title-txt-loading {
  width: 100%;
  max-width: 526rpx;
  height: 48rpx;
}

.topBar-container-right-icon-cover {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.topBar-container-right-icon {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 32rpx;
  width: auto;
  flex-shrink: 0;
  position: relative;
}

.topBar-userInfo-right-icon-badge {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  position: relative;
}

.topBar-right-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.topBar-icon-badge {
  width: 16rpx;
  height: 16rpx;
  position: absolute;
  right: -5rpx;
  top: -5rpx;
}

/* Logo */
.topBar-container-logo {
  display: flex;
  width: calc(750rpx - 96rpx);
  height: calc(88rpx - 24rpx);
  padding: 12rpx 48rpx;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.topBar-logo {
  display: flex;
  width: 176rpx;
  height: 48rpx;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.topBar-userInfo-bar {
  display: flex;
  width: calc(750rpx - 96rpx);
  height: calc(112rpx - 24rpx);
  padding: 12rpx 48rpx;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.topBar-userInfo-avatar-greeting {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.topBar-userInfo-profile-image-container {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 112rpx;
  background: #FFA76B;
  overflow: hidden;
}

.topBar-userInfo-profile-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  border-radius: 200rpx;
  object-fit: cover;
}

.topBar-username {
  font-feature-settings: 'clig'off, 'liga'off;
  font-style: normal;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.topBar-title-width {
  width: 100%;
  max-width: 100%;
}

.topBar-title-width-r-icon {
  width: 100%;
  max-width: 100%;
}

/* CHIP BUTTON */

.topBar-container-chip-button {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 32rpx;
  width: auto;
  flex-shrink: 0;
  position: relative;
}

.chip-button {
  display: grid;
  grid-auto-flow: column;
  grid-template-columns: auto 1fr;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 56rpx;
  padding: 0rpx 24rpx;
  gap: 8rpx;
  align-self: stretch;
  border-radius: var(--rounded-corner-x-large-32-px, 64rpx);
}

.icon-chip-button-image {
  width: 32rpx;
  height: 32rpx;
  justify-self: center;
}

.chip-button-title {
  color: #0E0E0E;
  text-align: left;
  font-feature-settings: 'liga'off, 'clig'off;
  line-height: 0px;
  align-self: center;
}

/* PIXEL MODE */

.topBar-container-px {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: -0.5px 0;
  width: 100%;
}

.topBar-upper-space-px {
  display: flex;
  width: calc(100% - 42px);
  padding: 0rpx 21px;
  justify-content: space-between;
  align-items: center;
  color: #00000000;
}

.topBar-title-bar-px {
  display: flex;
  width: calc(100% - 48px);
  height: calc(56px - 12px);
  padding: 6px 24px;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.topBar-slot-title-bar-px {
  display: flex;
  width: 100%;
  height: 56px;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.topBar-container-left-icon-px {
  width: 24px;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  cursor: pointer;
  flex-shrink: 0;
}

.topBar-left-icon-px {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.topBar-title-container-px {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-gap: 16px;
  align-items: center;
  justify-content: center;
  width: 85.2%;
}

.topBar-title-px {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.topBar-title-txt-px {
  width: 100%;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
  font-feature-settings: 'clig'off, 'liga'off;
  display: block;
}

.topBar-title-txt-loading-px {
  flex: 1;
  max-width: 263px;
  height: 24px;
}

.topBar-container-right-icon-cover-px {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.topBar-container-right-icon-px {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16px;
  width: auto;
  flex-shrink: 0;
  position: relative;
}

.topBar-userInfo-right-icon-badge-px {
  width: 24px;
  height: 24px;
  display: flex;
  position: relative;
}

.topBar-right-icon-px {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.topBar-icon-badge-px {
  width: 8px;
  height: 8px;
  position: absolute;
  right: -2.5px;
  top: -2.5px;
}
.topBar-icon-chip-notfiy-px {
  width: 9px;
  height: 9px;
  position: absolute;
  right: -0.6px;
  top: 1px;
}

/* Logo */
.topBar-container-logo-px {
  display: flex;
  width: calc(100% - 48px);
  height: calc(44px - 12px);
  padding: 6px 24px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.topBar-logo-px {
  display: flex;
