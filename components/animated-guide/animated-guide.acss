.animated-guide-overlay {
  z-index: 999999;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  position: fixed;
  animation: lpAgOverlayFadeIn 0.2s ease-out forwards;
}

@keyframes lpAgOverlayFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.lp-ag-overlay {
  width: 100vw;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: auto; /* Block touches behind */
  background: rgba(255, 255, 255, 0.001); /* Invisible solid background to intercept touches */
}

.lp-ag-cutout {
  background: rgba(255, 255, 255, 0.001); /* Invisible solid background to intercept touches */
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.75);
  position: absolute;
  width: calc(var(--cutout-width) + 8px);
  height: calc(var(--cutout-height) + 8px);
  margin-top: calc(var(--target-top) - 4px);
  margin-left: calc(var(--target-left) - 4px);
  border-radius: 16px;
  transition: all 0.3s ease;
}

.lp-ag-tooltip-container {
  position: absolute;
  left: 16px;
  right: 16px;
  opacity: 0;
  transform: scale(0.9);
  animation: lpAgFadeInScale 0.3s ease-out forwards;
  animation-delay: 0.4s; /* Wait almost for cutout shrink to finish */
  z-index: 100000;
}

.lp-ag-tooltip-content {
  background-color: var(--white);
  padding: 16px;
  border-radius: 12px;
  box-sizing: border-box;
}

.lp-ag-title {
  margin-bottom: 8px;
  font-weight: bold;
}

.lp-ag-detail {
  margin-bottom: 16px;
  color: var(--gray);
}

.lp-ag-bottom-content {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}


.lp-ag-button-group {
  display: flex;
  gap: 8px;
}

.lp-ag-btn-skip {
  background-color: transparent !important;
  color: var(--charcoal) !important;
}

.lp-ag-btn-next {
  /* turquoise handled by utility classes */
}

@keyframes lpAgFadeInScale {
  to {
    opacity: 1;
    transform: scale(1);
  }
}
